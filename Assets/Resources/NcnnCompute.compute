}

Texture2DArray<float4> _Pack4InArr;
RWStructuredBuffer<float> _Pack4Out;
int _Pack4W;
int _Pack4H;
int _Pack4C;

[numthreads(256,1,1)]
void NcnnPack4ToBufferCHW(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    uint wh = (uint)(_Pack4W * _Pack4H);
    uint c = idx / wh;
    if (c >= (uint)_Pack4C) return;
    uint rem = idx - c * wh;
    uint y = rem / (uint)_Pack4W;
    uint x = rem - y * (uint)_Pack4W;
    int pack = (int)(c >> 2);
    int lane = (int)(c & 3);
    float4 v = _Pack4InArr[int3((int)x, (int)y, pack)];
    float o = lane == 0 ? v.x : (lane == 1 ? v.y : (lane == 2 ? v.z : v.w));
    _Pack4Out[idx] = o;
}

StructuredBuffer<float> _IPIn;
StructuredBuffer<float> _IPW;
StructuredBuffer<float> _IPB;
RWStructuredBuffer<float> _IPOut;
int _IPInFeatures;
int _IPOutFeatures;

StructuredBuffer<float> _IP2In;
StructuredBuffer<float> _IP2W;
StructuredBuffer<float> _IP2B;
RWStructuredBuffer<float> _IP2Out;
int _IP2Rows;
int _IP2InFeatures;
int _IP2OutFeatures;

[numthreads(64,1,1)]
void NcnnInnerProduct(uint3 id : SV_DispatchThreadID)
{
    uint o = _BaseIndex + id.x;
    if (o >= (uint)_IPOutFeatures) return;
    float sum = _IPB[o];
    uint wbase = o * (uint)_IPInFeatures;
    for (int i = 0; i < _IPInFeatures; i++)
        sum += _IPW[wbase + (uint)i] * _IPIn[i];
    _IPOut[o] = sum;
}

[numthreads(8,8,1)]
void NcnnInnerProduct2D(uint3 id : SV_DispatchThreadID)
{
    int o = (int)id.x;
    int r = (int)id.y;
    if (o < 0 || r < 0) return;
    if (o >= _IP2OutFeatures || r >= _IP2Rows) return;
    float sum = _IP2B[o];
    uint inBase = (uint)r * (uint)_IP2InFeatures;
    uint wBase = (uint)o * (uint)_IP2InFeatures;
    for (int i = 0; i < _IP2InFeatures; i++)
    {
        sum += _IP2In[inBase + (uint)i] * _IP2W[wBase + (uint)i];
    }
    _IP2Out[(uint)r * (uint)_IP2OutFeatures + (uint)o] = sum;
}

StructuredBuffer<float> _MhaQ;
StructuredBuffer<float> _MhaK;
StructuredBuffer<float> _MhaV;
RWStructuredBuffer<float> _MhaOut;
int _MhaSrcLen;
int _MhaDstLen;
int _MhaEmbedDim;
int _MhaNumHeads;
int _MhaHeadDim;
float _MhaScale;
groupshared float _MhaScores[4096];

[numthreads(64,1,1)]
void NcnnMhaAttention(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    int q = (int)groupId.x;
    int head = (int)groupId.y;
    uint tid = groupThreadId.x;
    if (q < 0 || head < 0) return;
    if (q >= _MhaSrcLen || head >= _MhaNumHeads) return;
    int dst = _MhaDstLen;
    if (dst <= 0 || dst > 4096) return;

    int headDim = _MhaHeadDim;
    int embedDim = _MhaEmbedDim;
    int qBase = q * embedDim + head * headDim;
    int kHeadBase = head * headDim;

    // Correctness first: generator attention in CodeFormer uses headDim much larger than 64.
    // The previous implementation only accumulated the first 64 elements and only wrote the first
    // 64 output channels, which left most context entries undefined and caused unstable outputs.
    if (tid == 0)
    {
        float maxScore = -3.402823466e+38;
        for (int j = 0; j < dst; j++)
        {
            int kBase = j * embedDim + kHeadBase;
            float s = 0.0;
            for (int l = 0; l < headDim; l++)
            {
                s += _MhaQ[qBase + l] * _MhaK[kBase + l];
            }
            s *= _MhaScale;
            _MhaScores[j] = s;
            maxScore = max(maxScore, s);
        }

        float sumExp = 0.0;
        for (int j = 0; j < dst; j++)
        {
            float w = exp(_MhaScores[j] - maxScore);
            _MhaScores[j] = w;
            sumExp += w;
        }

        float invSum = 1.0 / max(sumExp, 1e-20);
        for (int j = 0; j < dst; j++)
        {
            _MhaScores[j] *= invSum;
        }
    }
    GroupMemoryBarrierWithGroupSync();

    for (int lane = (int)tid; lane < headDim; lane += 64)
    {
        float outv = 0.0;
        int vHeadBase = head * headDim + lane;
        for (int j = 0; j < dst; j++)
        {
            outv += _MhaScores[j] * _MhaV[j * embedDim + vHeadBase];
        }
        _MhaOut[q * embedDim + head * headDim + lane] = outv;
    }
}

StructuredBuffer<float> _FillIn;
RWTexture2DArray<float4> _FillOutArr;
int _FillW;
int _FillH;
int _FillC;

[numthreads(8,8,1)]
void NcnnFillPack4FromBufferCHW(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _FillOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    uint wh = w * h;
    int c0 = p * 4 + 0;
    int c1 = p * 4 + 1;
    int c2 = p * 4 + 2;
    int c3 = p * 4 + 3;
    uint idx0 = (uint)c0 * wh + id.y * w + id.x;
    uint idx1 = (uint)c1 * wh + id.y * w + id.x;
    uint idx2 = (uint)c2 * wh + id.y * w + id.x;
    uint idx3 = (uint)c3 * wh + id.y * w + id.x;
    float x0 = c0 < _FillC ? _FillIn[idx0] : 0.0;
    float x1 = c1 < _FillC ? _FillIn[idx1] : 0.0;
    float x2 = c2 < _FillC ? _FillIn[idx2] : 0.0;
    float x3 = c3 < _FillC ? _FillIn[idx3] : 0.0;
    _FillOutArr[int3((int)id.x, (int)id.y, p)] = float4(x0, x1, x2, x3);
}

Texture2DArray<float4> _ScaleInArr;
RWTexture2DArray<float4> _ScaleOutArr;
float _ScaleK;

[numthreads(8,8,1)]
void NcnnScalePack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ScaleOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _ScaleInArr[int3((int)id.x, (int)id.y, p)];
    _ScaleOutArr[int3((int)id.x, (int)id.y, p)] = v * _ScaleK;
}

Texture2DArray<float4> _BiasInArr;
RWTexture2DArray<float4> _BiasOutArr;
StructuredBuffer<float4> _Bias4;

[numthreads(8,8,1)]
void NcnnAddBiasPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _BiasOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _BiasInArr[int3((int)id.x, (int)id.y, p)];
    float4 b = _Bias4[p];
    _BiasOutArr[int3((int)id.x, (int)id.y, p)] = v + b;
}

Texture2DArray<float4> _BatchNormInArr;
RWTexture2DArray<float4> _BatchNormOutArr;
StructuredBuffer<float4> _BatchNormA4;
StructuredBuffer<float4> _BatchNormB4;

[numthreads(8,8,1)]
void NcnnBatchNormPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _BatchNormOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _BatchNormInArr[int3((int)id.x, (int)id.y, p)];
    float4 a = _BatchNormA4[p];
    float4 b = _BatchNormB4[p];
    _BatchNormOutArr[int3((int)id.x, (int)id.y, p)] = v * b + a;
}

Texture2DArray<float4> _LreluInArr;
RWTexture2DArray<float4> _LreluOutArr;
float _LreluSlope;

[numthreads(8,8,1)]
void NcnnLeakyReluPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _LreluOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _LreluInArr[int3((int)id.x, (int)id.y, p)];
    float4 o = max(v, 0.0) + min(v, 0.0) * _LreluSlope;
    _LreluOutArr[int3((int)id.x, (int)id.y, p)] = o;
}

RWTexture2DArray<float4> _NoiseInOutArr;
StructuredBuffer<float> _Noise;
float _NoiseWeight;

[numthreads(8,8,1)]
void NcnnAddNoiseBroadcastPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NoiseInOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    uint idx = id.y * w + id.x;
    float n = _Noise[idx] * _NoiseWeight;
    float4 v = _NoiseInOutArr[int3((int)id.x, (int)id.y, p)];
    _NoiseInOutArr[int3((int)id.x, (int)id.y, p)] = v + n;
}

Texture2DArray<float4> _ClipInArr;
RWTexture2DArray<float4> _ClipOutArr;
float _ClipMin;
float _ClipMax;

[numthreads(8,8,1)]
void NcnnClipPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ClipOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _ClipInArr[int3((int)id.x, (int)id.y, p)];
    _ClipOutArr[int3((int)id.x, (int)id.y, p)] = clamp(v, _ClipMin, _ClipMax);
}

Texture2DArray<float4> _SftInArr;
Texture2DArray<float4> _SftCondMulArr;
Texture2DArray<float4> _SftCondAddArr;
RWTexture2DArray<float4> _SftOutArr;
int _SftHalfPacks;

[numthreads(8,8,1)]
void NcnnSftPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _SftOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _SftInArr[int3((int)id.x, (int)id.y, p)];
    if (p >= _SftHalfPacks)
    {
        int cp = p - _SftHalfPacks;
        float4 m = _SftCondMulArr[int3((int)id.x, (int)id.y, cp)];
        float4 a = _SftCondAddArr[int3((int)id.x, (int)id.y, cp)];
        v = v * m + a;
    }
    _SftOutArr[int3((int)id.x, (int)id.y, p)] = v;
}

Texture2DArray<float4> _RgbInArr;
RWTexture2D<float4> _RgbOut;

[numthreads(32,32,1)]
void NcnnPack4ToRgb01(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _RgbOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    float4 v = _RgbInArr[int3((int)id.x, (int)id.y, 0)];
    v.xyz = v.xyz * 0.5 + 0.5;
    _RgbOut[int2((int)id.x, (int)id.y)] = float4(v.x, v.y, v.z, 1.0);
}
[numthreads(8,8,1)]
void NcnnConv3x3(uint3 id : SV_DispatchThreadID)
{
    int outW = _OutW;
    int outH = _OutH;
    int ox = (int)id.x;
    int oy = (int)id.y;
    int oc = (int)id.z;
    if (ox < 0 || oy < 0 || oc < 0) return;
    if (ox >= outW || oy >= outH || oc >= _OutC) return;

    float sum = _ConvB[oc];

    for (int ic = 0; ic < _InC; ic++)
    {
        for (int ky = 0; ky < 3; ky++)
        {
            for (int kx = 0; kx < 3; kx++)
            {
                int ix = ox * _Stride + kx - _Pad;
                int iy = oy * _Stride + ky - _Pad;
                if (ix < 0 || iy < 0 || ix >= _InW || iy >= _InH)
                    continue;

                uint inIdx = (uint)(ic * _InW * _InH + iy * _InW + ix);
                uint wIdx = (uint)(((oc * _InC + ic) * 3 + ky) * 3 + kx);
                sum += _ConvIn[inIdx] * _ConvW[wIdx];
            }
        }
    }

    sum = NcnnApplyActivationScalar(sum);

    uint outIndex = (uint)((oc * outH + oy) * outW + ox);
    _ConvOut[outIndex] = sum;
}

[numthreads(8,8,1)]
void NcnnConvDepthWise(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _OutW || (int)id.y >= _OutH || (int)id.z >= _OutC) return;

    int group = max(1, _ConvGroup);
    int inch_g = max(1, _InC / group);
    int outch_g = max(1, _OutC / group);
    int kernelArea = _KernelWVar * _KernelHVar;
    int oc = (int)id.z;
    int g = min(group - 1, oc / outch_g);
    int ocLocal = oc - g * outch_g;

    float sum = _ConvB[oc];
    int weightBase = ((g * outch_g + ocLocal) * inch_g) * kernelArea;

    for (int icLocal = 0; icLocal < inch_g; icLocal++)
    {
        int ic = g * inch_g + icLocal;
        int kernelBase = weightBase + icLocal * kernelArea;

        for (int ky = 0; ky < _KernelHVar; ky++)
        {
            int sy = (int)id.y * _StrideHVar - _PadTopVar + ky * _DilationHVar;
            if (sy < 0 || sy >= _InH) continue;

            for (int kx = 0; kx < _KernelWVar; kx++)
            {
                int sx = (int)id.x * _StrideWVar - _PadLeftVar + kx * _DilationWVar;
                if (sx < 0 || sx >= _InW) continue;

                int inputIndex = (ic * _InH + sy) * _InW + sx;
                int weightIndex = kernelBase + ky * _KernelWVar + kx;
                sum += _ConvIn[inputIndex] * _ConvW[weightIndex];
            }
        }
    }

    int outIndex = (oc * _OutH + (int)id.y) * _OutW + (int)id.x;
    _ConvOut[outIndex] = NcnnApplyActivationScalar(sum);
}

[numthreads(256,1,1)]
void NcnnTexToBuf3(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    uint w = (uint)_InW;
    uint h = (uint)_InH;
    uint n = w * h;
    if (idx >= n) return;
    uint x = idx % w;
    uint y = idx / w;
    int sx = (int)x + _OffsetX;
    int sy = (int)y + _OffsetY;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 c = _NcnnIn[int2(sx, sy)];
    _BufOut[idx] = c.x;
    _BufOut[n + idx] = c.y;
    _BufOut[n * 2 + idx] = c.z;
}

[numthreads(8,8,1)]
void NcnnBufToTex3(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    uint idx = id.y * w + id.x;
    uint n = w * h;
    float r = _BufA[idx];
    float g = _BufA[n + idx];
    float b = _BufA[n * 2 + idx];
    _NcnnOut[int2(id.x, id.y)] = float4(r, g, b, 1.0);
}

[numthreads(256,1,1)]
void NcnnLeakyReluBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    float v = _BufOut[idx];
    _BufOut[idx] = v >= 0.0 ? v : v * _CoeffA;
}

[numthreads(256,1,1)]
void NcnnAddWeighted(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    _BufOut[idx] = _BufA[idx] * _CoeffA + _BufB[idx] * _CoeffB;
}

[numthreads(256,1,1)]
void NcnnCopyBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    _BufOut[idx] = _BufA[idx];
}

[numthreads(256,1,1)]
void NcnnCopyBufPartial(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    _BufOut[idx + (uint)_DstOffset] = _BufA[idx + (uint)_SrcOffset];
}

[numthreads(256,1,1)]
void NcnnBinaryOpBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;

    float a = _BinaryBroadcastMode == 1 ? _BufA[idx % (uint)max(_BinaryBroadcastSize, 1)] : _BufA[idx];
    float b = _BinaryWithScalar != 0
        ? _BinaryScalar
        : (_BinaryBroadcastMode == 1
            ? _BufB[idx]
            : (_BinaryBroadcastMode == 2
                ? _BufB[idx % (uint)max(_BinaryBroadcastSize, 1)]
                : _BufB[idx]));

    float o = a;
    int t = _BinaryOpType;
    if (t == 0) o = a + b;
    else if (t == 1) o = a - b;
    else if (t == 2) o = a * b;
    else if (t == 3) o = a / max(b, 1e-12);
    else if (t == 4) o = max(a, b);
    else if (t == 5) o = min(a, b);
    else if (t == 6) o = pow(abs(a), b);
    else if (t == 7) o = b - a;
    else if (t == 8) o = b / max(a, 1e-12);
    else if (t == 9) o = pow(abs(b), a);
    _BufOut[idx] = o;
}

[numthreads(256,1,1)]
void NcnnUnaryOpBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;

    float x = _BufA[idx];
    float y = x;
    int t = _UnaryOpType;
    if (t == 0) y = abs(x);
    else if (t == 1) y = -x;
    else if (t == 2) y = floor(x);
    else if (t == 3) y = ceil(x);
    else if (t == 4) y = x * x;
    else if (t == 5) y = sqrt(max(x, 0.0));
    else if (t == 6) y = rsqrt(max(x, 1e-12));
    else if (t == 7) y = exp(x);
    else if (t == 8) y = log(max(x, 1e-12));
    else if (t == 9) y = sin(x);
    else if (t == 10) y = cos(x);
    else if (t == 11) y = tan(x);
    else if (t == 15) y = 1.0 / max(x, 1e-12);
    else if (t == 16) y = tanh(x);
    _BufOut[idx] = y;
}

[numthreads(256,1,1)]
void NcnnSigmoidBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    float x = _BufA[idx];
    _BufOut[idx] = 1.0 / (1.0 + exp(-x));
}

[numthreads(256,1,1)]
void NcnnSwishBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    float x = _BufA[idx];
    float s = 1.0 / (1.0 + exp(-x));
    _BufOut[idx] = x * s;
}

[numthreads(256,1,1)]
void NcnnGeluBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    float x = _BufA[idx];
    float x3 = x * x * x;
    float t = 0.7978845608 * (x + 0.044715 * x3);
    float y = 0.5 * x * (1.0 + tanh(t));
    _BufOut[idx] = y;
}

[numthreads(256,1,1)]
void NcnnCopyC(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_CopyTotal) return;
    uint wh = (uint)(_InW * _InH);
    uint ic = idx / wh;
    uint rem = idx - ic * wh;
    uint oc = ic + (uint)_ChanOffset;
    uint outIdx = oc * wh + rem;
    _BufOut[outIdx] = _BufA[idx];
}

[numthreads(64,1,1)]
void NcnnInterp2x(uint3 id : SV_DispatchThreadID)
{
    uint outIndex = _BaseIndex + id.x;
    uint inW = (uint)_InW;
    uint inH = (uint)_InH;
    uint inWH = inW * inH;
    uint outW = inW * 2;
    uint outH = inH * 2;
    uint outWH = outW * outH;
    uint outN = outWH * (uint)_InC;
    if (outIndex >= outN) return;

    uint c = outIndex / outWH;
    uint rem = outIndex - c * outWH;
    uint oy = rem / outW;
    uint ox = rem - oy * outW;

    float fx = ((float)ox + 0.5) * 0.5 - 0.5;
    float fy = ((float)oy + 0.5) * 0.5 - 0.5;
    int x0 = (int)floor(fx);
    int y0 = (int)floor(fy);
    int x1 = x0 + 1;
    int y1 = y0 + 1;
    float tx = fx - x0;
    float ty = fy - y0;
    x0 = clamp(x0, 0, (int)inW - 1);
    x1 = clamp(x1, 0, (int)inW - 1);
    y0 = clamp(y0, 0, (int)inH - 1);
    y1 = clamp(y1, 0, (int)inH - 1);

    uint baseC = c * inWH;
    float v00 = _BufA[baseC + (uint)(y0 * (int)inW + x0)];
    float v10 = _BufA[baseC + (uint)(y0 * (int)inW + x1)];
    float v01 = _BufA[baseC + (uint)(y1 * (int)inW + x0)];
    float v11 = _BufA[baseC + (uint)(y1 * (int)inW + x1)];
    float vx0 = lerp(v00, v10, tx);
    float vx1 = lerp(v01, v11, tx);
    float v = lerp(vx0, vx1, ty);
    _BufOut[outIndex] = v;
}

[numthreads(32,32,1)]
void NcnnBlitTileToDst(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _BlitW || (int)id.y >= _BlitH) return;

    int2 Dst;
    Dst.x = _DstX + (int)id.x;
    Dst.y = _DstY + (int)id.y;

    float2 srcF;
    srcF.x = (float)_TilePadX + ((float)id.x + 0.5f) * (float)_TileCoreW / (float)_BlitW - 0.5f;
    srcF.y = (float)_TilePadY + ((float)id.y + 0.5f) * (float)_TileCoreH / (float)_BlitH - 0.5f;

    int2 src0 = (int2)floor(srcF);
    int2 src1 = src0 + 1;
    float2 t = srcF - (float2)src0;

    int2 srcLimit = int2(_TileW - 1, _TileH - 1);
    src0 = clamp(src0, int2(0, 0), srcLimit);
    src1 = clamp(src1, int2(0, 0), srcLimit);

    float4 v00 = _NcnnInArr[int3(src0.x, src0.y, 0)];
    //float4 v10 = _NcnnInArr[int3(src1.x, src0.y, 0)];
    //float4 v01 = _NcnnInArr[int3(src0.x, src1.y, 0)];
    //float4 v11 = _NcnnInArr[int3(src1.x, src1.y, 0)];

    float4 v = v00;//lerp(lerp(v00, v10, t.x), lerp(v01, v11, t.x), t.y);
    v.w = 1.0;
    _NcnnOut[Dst] = v;
}

