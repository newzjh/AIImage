float _ActParam;

[numthreads(32,32,1)]
void NcnnPackRgbToPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NcnnOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    int sx = (int)id.x + _OffsetX;
    int sy = (int)id.y + _OffsetY;
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 v = _NcnnIn[int2(sx, sy)];
    _NcnnOutArr[int3((int)id.x, (int)id.y, 0)] = float4(v.x, v.y, v.z, 0.0);
}

[numthreads(32,32,1)]
void NcnnPackRgbToPack4Gfpgan(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NcnnOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    int sx = (int)id.x + _OffsetX;
    int sy = (int)id.y + _OffsetY;
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 v = _NcnnIn[int2(sx, sy)];
    v.xyz = v.xyz * 2.0 - 1.0;
    _NcnnOutArr[int3((int)id.x, (int)id.y, 0)] = float4(v.x, v.y, v.z, 0.0);
}

[numthreads(32,32,1)]
void NcnnUnpackPack4ToRgb(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    float4 v = _NcnnInArr[int3((int)id.x, (int)id.y, 0)];
    _NcnnOut[int2((int)id.x, (int)id.y)] = float4(v.x, v.y, v.z, 1.0);
}

StructuredBuffer<float4> _ConvW4;
StructuredBuffer<float4> _ConvB4;
RWTexture2DArray<float4> _ConvOutArr;
Texture2DArray<float4> _ConvInArr;
int _InPacks;
int _OutPacks;

groupshared float4 _Conv3x3Pack4_s_in[100];
groupshared float4 _Conv3x3Pack4_s_w[36];

[numthreads(8,8,1)]
void NcnnConv3x3Pack4(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _ConvOutArr.GetDimensions(ow, oh, od);
    bool active = (id.x < ow && id.y < oh);
    int op = (int)id.z;

    float4 sum = _ConvB4[op];

    uint iw, ih, idd;
    _ConvInArr.GetDimensions(iw, ih, idd);

    int baseX = (int)groupId.x * 8;
    int baseY = (int)groupId.y * 8;
    int tid = (int)groupThreadId.y * 8 + (int)groupThreadId.x;

    for (int ip0 = 0; ip0 < _InPacks; ip0++)
    {
        for (int loadIndex = tid; loadIndex < 100; loadIndex += 64)
        {
            int ly = (int)((float)loadIndex * 0.1);
            int lx = loadIndex - ly * 10;
            int ix = baseX + lx - _Pad;
            int iy = baseY + ly - _Pad;
            float4 v = 0.0;
            if (ix >= 0 && iy >= 0 && ix < (int)iw && iy < (int)ih)
                v = _ConvInArr[int3(ix, iy, ip0)];
            _Conv3x3Pack4_s_in[loadIndex] = v;
        }

        if (tid == 0)
        {
            int wbase = ((op * _InPacks + ip0) * 9 * 4);
            [unroll]
            for (int k = 0; k < 9; k++)
            {
                _Conv3x3Pack4_s_w[k * 4 + 0] = _ConvW4[wbase + k * 4 + 0];
                _Conv3x3Pack4_s_w[k * 4 + 1] = _ConvW4[wbase + k * 4 + 1];
                _Conv3x3Pack4_s_w[k * 4 + 2] = _ConvW4[wbase + k * 4 + 2];
                _Conv3x3Pack4_s_w[k * 4 + 3] = _ConvW4[wbase + k * 4 + 3];
            }
        }

        GroupMemoryBarrierWithGroupSync();

        int tx = (int)groupThreadId.x;
        int ty = (int)groupThreadId.y;

        [unroll]
        for (int ky = 0; ky < 3; ky++)
        {
            [unroll]
            for (int kx = 0; kx < 3; kx++)
            {
                float4 inV = _Conv3x3Pack4_s_in[(ty + ky) * 10 + (tx + kx)];
                int k = ky * 3 + kx;
                float4 w0 = _Conv3x3Pack4_s_w[k * 4 + 0];
                float4 w1 = _Conv3x3Pack4_s_w[k * 4 + 1];
                float4 w2 = _Conv3x3Pack4_s_w[k * 4 + 2];
                float4 w3 = _Conv3x3Pack4_s_w[k * 4 + 3];
                sum.x += dot(inV, w0);
                sum.y += dot(inV, w1);
                sum.z += dot(inV, w2);
                sum.w += dot(inV, w3);
            }
        }

        GroupMemoryBarrierWithGroupSync();
    }

    if (_ActType == 2)
        sum = max(sum, 0.0) + min(sum, 0.0) * _ActParam;

    if (active)
        _ConvOutArr[int3((int)id.x, (int)id.y, op)] = sum;
}

[numthreads(8,8,1)]
void NcnnConv1x1Pack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _ConvOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int op = (int)id.z;
    if (op < 0 || op >= _OutPacks) return;

    float4 sum = _ConvB4[op];

    for (int ip0 = 0; ip0 < _InPacks; ip0++)
    {
        float4 inV = _ConvInArr[int3((int)id.x, (int)id.y, ip0)];
        int base = ((op * _InPacks + ip0) * 4);
        float4 w0 = _ConvW4[base + 0];
        float4 w1 = _ConvW4[base + 1];
        float4 w2 = _ConvW4[base + 2];
        float4 w3 = _ConvW4[base + 3];
        sum.x += dot(inV, w0);
        sum.y += dot(inV, w1);
        sum.z += dot(inV, w2);
        sum.w += dot(inV, w3);
    }

    if (_ActType == 2)
        sum = max(sum, 0.0) + min(sum, 0.0) * _ActParam;

    _ConvOutArr[int3((int)id.x, (int)id.y, op)] = sum;
}

RWTexture2DArray<float4> _AddOutArr;
Texture2DArray<float4> _AddA;
Texture2DArray<float4> _AddB;

[numthreads(8,8,1)]
void NcnnAddPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _AddOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 a = _AddA[int3((int)id.x, (int)id.y, p)];
    float4 b = _AddB[int3((int)id.x, (int)id.y, p)];
    _AddOutArr[int3((int)id.x, (int)id.y, p)] = a * _CoeffA + b * _CoeffB;
}

RWTexture2DArray<float4> _CopyOutArr;
Texture2DArray<float4> _CopyInArr;
int _CopyInOffset;
int _CopyOutOffset;
int _CopyPacks;

[numthreads(8,8,1)]
void NcnnCopyPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _CopyOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= _CopyPacks) return;
    int inP = _CopyInOffset + p;
    int outP = _CopyOutOffset + p;
    float4 v = _CopyInArr[int3((int)id.x, (int)id.y, inP)];
    _CopyOutArr[int3((int)id.x, (int)id.y, outP)] = v;
}

RWTexture2DArray<float4> _InterpOutArr;
Texture2DArray<float4> _InterpInArr;

[numthreads(8,8,1)]
void NcnnInterp2xPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;
    uint iw, ih, idd;
    _InterpInArr.GetDimensions(iw, ih, idd);

    float fx = ((float)id.x + 0.5) * 0.5 - 0.5;
    float fy = ((float)id.y + 0.5) * 0.5 - 0.5;
    int x0 = (int)floor(fx);
    int y0 = (int)floor(fy);
    float tx = fx - x0;
    float ty = fy - y0;
    if (x0 < 0) { x0 = 0; tx = 0.0; }
    if (y0 < 0) { y0 = 0; ty = 0.0; }
    if (x0 >= (int)iw - 1) { x0 = max(0, (int)iw - 2); tx = 1.0; }
    if (y0 >= (int)ih - 1) { y0 = max(0, (int)ih - 2); ty = 1.0; }
    int x1 = x0 + 1;
    int y1 = y0 + 1;

    float4 v00 = _InterpInArr[int3(x0, y0, p)];
    float4 v10 = _InterpInArr[int3(x1, y0, p)];
    float4 v01 = _InterpInArr[int3(x0, y1, p)];
    float4 v11 = _InterpInArr[int3(x1, y1, p)];
    float4 vx0 = lerp(v00, v10, tx);
    float4 vx1 = lerp(v01, v11, tx);
    float4 v = lerp(vx0, vx1, ty);
    _InterpOutArr[int3((int)id.x, (int)id.y, p)] = v;
}

RWTexture2DArray<float4> _InterpNnOutArr;
Texture2DArray<float4> _InterpNnInArr;

[numthreads(8,8,1)]
void NcnnInterp2xNearestPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpNnOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _InterpNnInArr.GetDimensions(iw, ih, idd);
    int sx = min((int)(id.x >> 1), (int)iw - 1);
    int sy = min((int)(id.y >> 1), (int)ih - 1);
    _InterpNnOutArr[int3((int)id.x, (int)id.y, p)] = _InterpNnInArr[int3(sx, sy, p)];
}

RWTexture2DArray<float4> _InterpDownOutArr;
Texture2DArray<float4> _InterpDownInArr;

[numthreads(8,8,1)]
void NcnnInterpDown2Pack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpDownOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
