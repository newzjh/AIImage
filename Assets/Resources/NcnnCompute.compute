float NcnnGnApplyOneTex(float x, int c)
{
    if (c < 0 || c >= _GnC)
        return 0.0;
    int g = c / max(1, _GnChannelsG);
    float2 stats = _GnStatsTexIn[int3(g, 0, 0)].xy;
    float y = (x - stats.x) * rsqrt(max(stats.y + _GnEps, 1e-20));
    if (_GnAffine != 0)
        y = y * _GnGamma[c] + _GnBeta[c];
    return y;
}

