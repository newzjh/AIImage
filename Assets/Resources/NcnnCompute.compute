float4 NcnnErfApprox4(float4 x)
{
    float4 a1 = 0.254829592;
    float4 a2 = -0.284496736;
    float4 a3 = 1.421413741;
    float4 a4 = -1.453152027;
    float4 a5 = 1.061405429;
    float4 p = 0.3275911;
    float4 s = sign(x);
    float4 xAbs = abs(x);
    float4 t = 1.0 / (1.0 + p * xAbs);
    float4 y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp(-xAbs * xAbs);
    return s * y;
}

float4 NcnnApplyPointwise4(float4 x)
{
    int t = _PointwiseType;
    if (t == 0) return x < 0.0 ? _PointwiseA * (exp(x) - 1.0) : x;
    if (t == 1) return NcnnErfApprox4(x);
    if (t == 2)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        return x < lower ? 0.0 : x > upper ? 1.0 : x * alpha + beta;
    }
    if (t == 3)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        return x < lower ? 0.0 : x > upper ? x : x * (x * alpha + beta);
    }
    if (t == 4)
    {
        float4 y = x > 20.0 ? x : x < -20.0 ? exp(x) : log(exp(x) + 1.0);
        return x * tanh(y);
    }
    if (t == 5)
    {
        float alpha = _PointwiseA;
        float lambda = _PointwiseB;
        return x < 0.0 ? (exp(x) - 1.0) * alpha * lambda : x * lambda;
    }
    if (t == 6)
    {
        float bias = _PointwiseA;
        float lambd = _PointwiseB;
        return x < -lambd ? x + bias : x > lambd ? x - bias : 0.0;
    }
    if (t == 7) return log(exp(x) + 1.0);
    if (t == 8)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 1.0 : _PointwiseA;
        return x < 0.0 ? (exp(x / alpha) - 1.0) * alpha : x;
    }
    if (t == 9) return x * _PointwiseA;
    return x;
}

int NcnnQuantAxisIndex(int idx)
{
    if (_QuantDims <= 1)
        return idx;
    if (_QuantDims == 2)
        return idx / max(1, _QuantW);
    int plane = max(1, _QuantW * _QuantH * _QuantD);
    return idx / plane;
}

float NcnnResolveQuantScaleIn(int axis)
{
    if (_QuantScaleInSize <= 0)
        return 1.0;
    if (_QuantScaleInSize == 1)
        return _QuantScale[0];
    return _QuantScale[clamp(axis, 0, _QuantScaleInSize - 1)];
}

float NcnnResolveQuantScaleOut(int axis)
{
    if (_QuantScaleOutSize <= 0)
        return 1.0;
    if (_QuantScaleOutSize == 1)
        return _QuantScaleOut[0];
    return _QuantScaleOut[clamp(axis, 0, _QuantScaleOutSize - 1)];
}

float NcnnResolveQuantBias(int axis)
{
    if (_QuantBiasSize <= 0)
        return 0.0;
    if (_QuantBiasSize == 1)
        return _QuantBias[0];
    return _QuantBias[clamp(axis, 0, _QuantBiasSize - 1)];
}

float NcnnApplyActivationScalarQuant(float v)
{
    if (_QuantActType == 1)
        return max(v, 0.0);
    if (_QuantActType == 2)
        return v < 0.0 ? v * _QuantActParam0 : v;
    if (_QuantActType == 3)
        return clamp(v, _QuantActParam0, _QuantActParam1);
    if (_QuantActType == 4)
        return 1.0 / (1.0 + exp(-v));
    if (_QuantActType == 5)
        return v * tanh(log(exp(v) + 1.0));
    if (_QuantActType == 6)
        return v * clamp(v * _QuantActParam0 + _QuantActParam1, 0.0, 1.0);
    return v;
}

float NcnnCastScalar(float value)
{
    if (_CastTypeFrom == _CastTypeTo)
        return value;

    if (_CastTypeFrom == 1 && _CastTypeTo == 2)
    {
        return f16tof32(f32tof16(value));
    }

    if (_CastTypeFrom == 1 && _CastTypeTo == 4)
    {
        uint bits = asuint(value);
        uint lsb = (bits >> 16) & 1;
        bits += 0x7FFFu + lsb;
        bits &= 0xFFFF0000u;
        return asfloat(bits);
    }

    if (_CastTypeFrom == 1 && _CastTypeTo == 3)
    {
        float tmp = value >= 0.0 ? value + 0.5 : value - 0.5;
        return clamp((float)(int)tmp, -128.0, 127.0);
    }

    return value;
}

int NcnnBufferAxisIndex(int dims, int w, int h, int d, int c, int idx)
{
    if (dims <= 1)
        return idx;
    if (dims == 2)
        return idx / max(1, w);
    int plane = max(1, w * h * d);
    return idx / plane;
}

float NcnnResolveScaleValue(int axis)
{
    if (_ScaleDataSize <= 0)
        return 1.0;
    if (_ScaleDataSize == 1)
        return _ScaleScaleBuf[0];
    return _ScaleScaleBuf[clamp(axis, 0, _ScaleDataSize - 1)];
}

float NcnnResolveScaleBias(int axis)
{
    if (_ScaleBiasTerm == 0)
        return 0.0;
    if (_ScaleDataSize <= 0)
        return 0.0;
    if (_ScaleDataSize == 1)
        return _ScaleBiasBuf[0];
    return _ScaleBiasBuf[clamp(axis, 0, _ScaleDataSize - 1)];
}

float NcnnResolvePReluSlope(int axis)
{
    if (_PReluSlopeCount <= 0)
        return 0.0;
    if (_PReluSlopeCount == 1)
        return _PReluSlopeBuf[0];
    return _PReluSlopeBuf[clamp(axis, 0, _PReluSlopeCount - 1)];
}

