        int srcH = _PermutePack4Axis0 == 1 ? x : (_PermutePack4Axis1 == 1 ? y : oc4.z);
        int srcC = _PermutePack4Axis0 == 2 ? x : (_PermutePack4Axis1 == 2 ? y : oc4.z);
        o.z = NcnnReadPack4Channel(_PermutePack4InArr, srcW, srcH, srcC);
