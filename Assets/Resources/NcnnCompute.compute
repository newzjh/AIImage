float _ActParam;

[numthreads(32,32,1)]
void NcnnPackRgbToPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NcnnOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    int sx = (int)id.x + _OffsetX;
    int sy = (int)id.y + _OffsetY;
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 v = _NcnnIn[int2(sx, sy)];
    _NcnnOutArr[int3((int)id.x, (int)id.y, 0)] = float4(v.x, v.y, v.z, 0.0);
}

[numthreads(32,32,1)]
void NcnnPackRgbToPack4Gfpgan(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NcnnOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    int sx = (int)id.x + _OffsetX;
    int sy = (int)id.y + _OffsetY;
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 v = _NcnnIn[int2(sx, sy)];
    v.xyz = v.xyz * 2.0 - 1.0;
    _NcnnOutArr[int3((int)id.x, (int)id.y, 0)] = float4(v.x, v.y, v.z, 0.0);
}

[numthreads(32,32,1)]
void NcnnUnpackPack4ToRgb(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    float4 v = _NcnnInArr[int3((int)id.x, (int)id.y, 0)];
    _NcnnOut[int2((int)id.x, (int)id.y)] = float4(v.x, v.y, v.z, 1.0);
}

StructuredBuffer<float4> _ConvW4;
StructuredBuffer<float4> _ConvB4;
RWTexture2DArray<float4> _ConvOutArr;
Texture2DArray<float4> _ConvInArr;
int _InPacks;
int _OutPacks;

groupshared float4 _Conv3x3Pack4_s_in[100];
groupshared float4 _Conv3x3Pack4_s_w[36];

[numthreads(8,8,1)]
void NcnnConv3x3Pack4(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _ConvOutArr.GetDimensions(ow, oh, od);
    bool active = (id.x < ow && id.y < oh);
    int op = (int)id.z;

    float4 sum = _ConvB4[op];

    uint iw, ih, idd;
    _ConvInArr.GetDimensions(iw, ih, idd);

    int baseX = (int)groupId.x * 8;
    int baseY = (int)groupId.y * 8;
    int tid = (int)groupThreadId.y * 8 + (int)groupThreadId.x;

#if defined(SHADER_API_D3D11)
    // D3D11 下避免 groupshared + barrier（容易触发卡死/驱动 TDR），使用朴素实现确保稳定
    if (active)
    {
        for (int ip = 0; ip < _InPacks; ip++)
        {
            for (int ky = 0; ky < 3; ky++)
            {
                for (int kx = 0; kx < 3; kx++)
                {
                    int ix = (int)id.x + kx - _Pad;
                    int iy = (int)id.y + ky - _Pad;
                    float4 inV = 0.0;
                    if (ix >= 0 && iy >= 0 && ix < (int)iw && iy < (int)ih)
                        inV = _ConvInArr[int3(ix, iy, ip)];

                    int base = ((((op * _InPacks + ip) * 3 + ky) * 3 + kx) * 4);
                    float4 w0 = _ConvW4[base + 0];
                    float4 w1 = _ConvW4[base + 1];
                    float4 w2 = _ConvW4[base + 2];
                    float4 w3 = _ConvW4[base + 3];
                    sum.x += dot(inV, w0);
                    sum.y += dot(inV, w1);
                    sum.z += dot(inV, w2);
                    sum.w += dot(inV, w3);
                }
            }
        }
    }
#else
    for (int ip = 0; ip < _InPacks; ip++)
    {
        for (int loadIndex = tid; loadIndex < 100; loadIndex += 64)
        {
            int lx = loadIndex - (loadIndex / 10) * 10;
            int ly = loadIndex / 10;
            int ix = baseX + lx - _Pad;
            int iy = baseY + ly - _Pad;
            float4 v = 0.0;
            if (ix >= 0 && iy >= 0 && ix < (int)iw && iy < (int)ih)
                v = _ConvInArr[int3(ix, iy, ip)];
            _Conv3x3Pack4_s_in[loadIndex] = v;
        }

        if (tid == 0)
        {
            int wbase = ((op * _InPacks + ip) * 9 * 4);
            [unroll]
            for (int k = 0; k < 9; k++)
            {
                _Conv3x3Pack4_s_w[k * 4 + 0] = _ConvW4[wbase + k * 4 + 0];
                _Conv3x3Pack4_s_w[k * 4 + 1] = _ConvW4[wbase + k * 4 + 1];
                _Conv3x3Pack4_s_w[k * 4 + 2] = _ConvW4[wbase + k * 4 + 2];
                _Conv3x3Pack4_s_w[k * 4 + 3] = _ConvW4[wbase + k * 4 + 3];
            }
        }

        GroupMemoryBarrierWithGroupSync();

        int tx = (int)groupThreadId.x;
        int ty = (int)groupThreadId.y;

        [unroll]
        for (int ky = 0; ky < 3; ky++)
        {
            [unroll]
            for (int kx = 0; kx < 3; kx++)
            {
                float4 inV = _Conv3x3Pack4_s_in[(ty + ky) * 10 + (tx + kx)];
                int k = ky * 3 + kx;
                float4 w0 = _Conv3x3Pack4_s_w[k * 4 + 0];
                float4 w1 = _Conv3x3Pack4_s_w[k * 4 + 1];
                float4 w2 = _Conv3x3Pack4_s_w[k * 4 + 2];
                float4 w3 = _Conv3x3Pack4_s_w[k * 4 + 3];
                sum.x += dot(inV, w0);
                sum.y += dot(inV, w1);
                sum.z += dot(inV, w2);
                sum.w += dot(inV, w3);
            }
        }

        GroupMemoryBarrierWithGroupSync();
    }
#endif

    if (_ActType == 2)
        sum = max(sum, 0.0) + min(sum, 0.0) * _ActParam;

    if (active)
        _ConvOutArr[int3((int)id.x, (int)id.y, op)] = sum;
}

[numthreads(8,8,1)]
void NcnnConv1x1Pack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _ConvOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int op = (int)id.z;
    if (op < 0 || op >= _OutPacks) return;

    float4 sum = _ConvB4[op];

    for (int ip = 0; ip < _InPacks; ip++)
    {
        float4 inV = _ConvInArr[int3((int)id.x, (int)id.y, ip)];
        int base = ((op * _InPacks + ip) * 4);
        float4 w0 = _ConvW4[base + 0];
        float4 w1 = _ConvW4[base + 1];
        float4 w2 = _ConvW4[base + 2];
        float4 w3 = _ConvW4[base + 3];
        sum.x += dot(inV, w0);
        sum.y += dot(inV, w1);
        sum.z += dot(inV, w2);
        sum.w += dot(inV, w3);
    }

    if (_ActType == 2)
        sum = max(sum, 0.0) + min(sum, 0.0) * _ActParam;

    _ConvOutArr[int3((int)id.x, (int)id.y, op)] = sum;
}

RWTexture2DArray<float4> _AddOutArr;
Texture2DArray<float4> _AddA;
Texture2DArray<float4> _AddB;

[numthreads(8,8,1)]
void NcnnAddPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _AddOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 a = _AddA[int3((int)id.x, (int)id.y, p)];
    float4 b = _AddB[int3((int)id.x, (int)id.y, p)];
    _AddOutArr[int3((int)id.x, (int)id.y, p)] = a * _CoeffA + b * _CoeffB;
}

RWTexture2DArray<float4> _CopyOutArr;
Texture2DArray<float4> _CopyInArr;
int _CopyInOffset;
int _CopyOutOffset;
int _CopyPacks;

[numthreads(8,8,1)]
void NcnnCopyPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _CopyOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= _CopyPacks) return;
    int inP = _CopyInOffset + p;
    int outP = _CopyOutOffset + p;
    float4 v = _CopyInArr[int3((int)id.x, (int)id.y, inP)];
    _CopyOutArr[int3((int)id.x, (int)id.y, outP)] = v;
}

RWTexture2DArray<float4> _InterpOutArr;
Texture2DArray<float4> _InterpInArr;

[numthreads(8,8,1)]
void NcnnInterp2xPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;
    uint iw, ih, idd;
    _InterpInArr.GetDimensions(iw, ih, idd);

    float fx = ((float)id.x + 0.5) * 0.5 - 0.5;
    float fy = ((float)id.y + 0.5) * 0.5 - 0.5;
    int x0 = (int)floor(fx);
    int y0 = (int)floor(fy);
    float tx = fx - x0;
    float ty = fy - y0;
    if (x0 < 0) { x0 = 0; tx = 0.0; }
    if (y0 < 0) { y0 = 0; ty = 0.0; }
    if (x0 >= (int)iw - 1) { x0 = max(0, (int)iw - 2); tx = 1.0; }
    if (y0 >= (int)ih - 1) { y0 = max(0, (int)ih - 2); ty = 1.0; }
    int x1 = x0 + 1;
    int y1 = y0 + 1;

    float4 v00 = _InterpInArr[int3(x0, y0, p)];
    float4 v10 = _InterpInArr[int3(x1, y0, p)];
    float4 v01 = _InterpInArr[int3(x0, y1, p)];
    float4 v11 = _InterpInArr[int3(x1, y1, p)];
    float4 vx0 = lerp(v00, v10, tx);
    float4 vx1 = lerp(v01, v11, tx);
    float4 v = lerp(vx0, vx1, ty);
    _InterpOutArr[int3((int)id.x, (int)id.y, p)] = v;
}

RWTexture2DArray<float4> _InterpNnOutArr;
Texture2DArray<float4> _InterpNnInArr;

[numthreads(8,8,1)]
void NcnnInterp2xNearestPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpNnOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _InterpNnInArr.GetDimensions(iw, ih, idd);
    int sx = min((int)(id.x >> 1), (int)iw - 1);
    int sy = min((int)(id.y >> 1), (int)ih - 1);
    _InterpNnOutArr[int3((int)id.x, (int)id.y, p)] = _InterpNnInArr[int3(sx, sy, p)];
}

RWTexture2DArray<float4> _InterpDownOutArr;
Texture2DArray<float4> _InterpDownInArr;

[numthreads(8,8,1)]
void NcnnInterpDown2Pack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpDownOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;
    uint iw, ih, idd;
    _InterpDownInArr.GetDimensions(iw, ih, idd);

    float fx = ((float)id.x + 0.5) / 0.5 - 0.5;
    float fy = ((float)id.y + 0.5) / 0.5 - 0.5;
    int x0 = (int)floor(fx);
    int y0 = (int)floor(fy);
    float tx = fx - x0;
    float ty = fy - y0;
    if (x0 < 0) { x0 = 0; tx = 0.0; }
    if (y0 < 0) { y0 = 0; ty = 0.0; }
    if (x0 >= (int)iw - 1) { x0 = max(0, (int)iw - 2); tx = 1.0; }
    if (y0 >= (int)ih - 1) { y0 = max(0, (int)ih - 2); ty = 1.0; }
    int x1 = x0 + 1;
    int y1 = y0 + 1;

    float4 v00 = _InterpDownInArr[int3(x0, y0, p)];
    float4 v10 = _InterpDownInArr[int3(x1, y0, p)];
    float4 v01 = _InterpDownInArr[int3(x0, y1, p)];
    float4 v11 = _InterpDownInArr[int3(x1, y1, p)];
    float4 vx0 = lerp(v00, v10, tx);
    float4 vx1 = lerp(v01, v11, tx);
    float4 v = lerp(vx0, vx1, ty);
    _InterpDownOutArr[int3((int)id.x, (int)id.y, p)] = v;
}

RWTexture2DArray<float4> _InterpDownNnOutArr;
Texture2DArray<float4> _InterpDownNnInArr;

[numthreads(8,8,1)]
void NcnnInterpDown2NearestPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _InterpDownNnOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _InterpDownNnInArr.GetDimensions(iw, ih, idd);
    int sx = min((int)(id.x * 2), (int)iw - 1);
    int sy = min((int)(id.y * 2), (int)ih - 1);
    _InterpDownNnOutArr[int3((int)id.x, (int)id.y, p)] = _InterpDownNnInArr[int3(sx, sy, p)];
}

Texture2DArray<float4> _Pack4InArr;
RWStructuredBuffer<float> _Pack4Out;
int _Pack4W;
int _Pack4H;
int _Pack4C;

[numthreads(256,1,1)]
void NcnnPack4ToBufferCHW(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    uint wh = (uint)(_Pack4W * _Pack4H);
    uint c = idx / wh;
    if (c >= (uint)_Pack4C) return;
    uint rem = idx - c * wh;
    uint y = rem / (uint)_Pack4W;
    uint x = rem - y * (uint)_Pack4W;
    int pack = (int)(c >> 2);
    int lane = (int)(c & 3);
    float4 v = _Pack4InArr[int3((int)x, (int)y, pack)];
    float o = lane == 0 ? v.x : (lane == 1 ? v.y : (lane == 2 ? v.z : v.w));
    _Pack4Out[idx] = o;
}

StructuredBuffer<float> _IPIn;
StructuredBuffer<float> _IPW;
StructuredBuffer<float> _IPB;
RWStructuredBuffer<float> _IPOut;
int _IPInFeatures;
int _IPOutFeatures;

[numthreads(64,1,1)]
void NcnnInnerProduct(uint3 id : SV_DispatchThreadID)
{
    uint o = _BaseIndex + id.x;
    if (o >= (uint)_IPOutFeatures) return;
    float sum = _IPB[o];
    uint wbase = o * (uint)_IPInFeatures;
    for (int i = 0; i < _IPInFeatures; i++)
        sum += _IPW[wbase + (uint)i] * _IPIn[i];
    _IPOut[o] = sum;
}

StructuredBuffer<float> _FillIn;
RWTexture2DArray<float4> _FillOutArr;
int _FillW;
int _FillH;
int _FillC;

[numthreads(8,8,1)]
void NcnnFillPack4FromBufferCHW(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _FillOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    uint wh = w * h;
    int c0 = p * 4 + 0;
    int c1 = p * 4 + 1;
    int c2 = p * 4 + 2;
    int c3 = p * 4 + 3;
    uint idx0 = (uint)c0 * wh + id.y * w + id.x;
    uint idx1 = (uint)c1 * wh + id.y * w + id.x;
    uint idx2 = (uint)c2 * wh + id.y * w + id.x;
    uint idx3 = (uint)c3 * wh + id.y * w + id.x;
    float x0 = c0 < _FillC ? _FillIn[idx0] : 0.0;
    float x1 = c1 < _FillC ? _FillIn[idx1] : 0.0;
    float x2 = c2 < _FillC ? _FillIn[idx2] : 0.0;
    float x3 = c3 < _FillC ? _FillIn[idx3] : 0.0;
    _FillOutArr[int3((int)id.x, (int)id.y, p)] = float4(x0, x1, x2, x3);
}

Texture2DArray<float4> _ScaleInArr;
RWTexture2DArray<float4> _ScaleOutArr;
float _ScaleK;

[numthreads(8,8,1)]
void NcnnScalePack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ScaleOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _ScaleInArr[int3((int)id.x, (int)id.y, p)];
    _ScaleOutArr[int3((int)id.x, (int)id.y, p)] = v * _ScaleK;
}

Texture2DArray<float4> _BiasInArr;
RWTexture2DArray<float4> _BiasOutArr;
StructuredBuffer<float4> _Bias4;

[numthreads(8,8,1)]
void NcnnAddBiasPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _BiasOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _BiasInArr[int3((int)id.x, (int)id.y, p)];
    float4 b = _Bias4[p];
    _BiasOutArr[int3((int)id.x, (int)id.y, p)] = v + b;
}

Texture2DArray<float4> _LreluInArr;
RWTexture2DArray<float4> _LreluOutArr;
float _LreluSlope;

[numthreads(8,8,1)]
void NcnnLeakyReluPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _LreluOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _LreluInArr[int3((int)id.x, (int)id.y, p)];
    float4 o = max(v, 0.0) + min(v, 0.0) * _LreluSlope;
    _LreluOutArr[int3((int)id.x, (int)id.y, p)] = o;
}

RWTexture2DArray<float4> _NoiseInOutArr;
StructuredBuffer<float> _Noise;
float _NoiseWeight;

[numthreads(8,8,1)]
void NcnnAddNoiseBroadcastPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _NoiseInOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    uint idx = id.y * w + id.x;
    float n = _Noise[idx] * _NoiseWeight;
    float4 v = _NoiseInOutArr[int3((int)id.x, (int)id.y, p)];
    _NoiseInOutArr[int3((int)id.x, (int)id.y, p)] = v + n;
}

Texture2DArray<float4> _ClipInArr;
RWTexture2DArray<float4> _ClipOutArr;
float _ClipMin;
float _ClipMax;

[numthreads(8,8,1)]
void NcnnClipPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ClipOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _ClipInArr[int3((int)id.x, (int)id.y, p)];
    _ClipOutArr[int3((int)id.x, (int)id.y, p)] = clamp(v, _ClipMin, _ClipMax);
}

Texture2DArray<float4> _SftInArr;
Texture2DArray<float4> _SftCondMulArr;
Texture2DArray<float4> _SftCondAddArr;
RWTexture2DArray<float4> _SftOutArr;
int _SftHalfPacks;

[numthreads(8,8,1)]
void NcnnSftPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _SftOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 v = _SftInArr[int3((int)id.x, (int)id.y, p)];
    if (p >= _SftHalfPacks)
    {
        int cp = p - _SftHalfPacks;
        float4 m = _SftCondMulArr[int3((int)id.x, (int)id.y, cp)];
        float4 a = _SftCondAddArr[int3((int)id.x, (int)id.y, cp)];
        v = v * m + a;
    }
    _SftOutArr[int3((int)id.x, (int)id.y, p)] = v;
}

Texture2DArray<float4> _RgbInArr;
RWTexture2D<float4> _RgbOut;

[numthreads(32,32,1)]
void NcnnPack4ToRgb01(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _RgbOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    float4 v = _RgbInArr[int3((int)id.x, (int)id.y, 0)];
    v.xyz = v.xyz * 0.5 + 0.5;
    _RgbOut[int2((int)id.x, (int)id.y)] = float4(v.x, v.y, v.z, 1.0);
}
[numthreads(64,1,1)]
void NcnnConv3x3(uint3 id : SV_DispatchThreadID)
{
    uint outIndex = _BaseIndex + id.x;
    int outW = _InW;
    int outH = _InH;
    uint outN = (uint)(outW * outH * _OutC);
    if (outIndex >= outN) return;

    int oc = (int)(outIndex / (uint)(outW * outH));
    int rem = (int)(outIndex - (uint)(oc * outW * outH));
    int oy = rem / outW;
    int ox = rem - oy * outW;

    float sum = _ConvB[oc];

    for (int ic = 0; ic < _InC; ic++)
    {
        for (int ky = 0; ky < 3; ky++)
        {
            for (int kx = 0; kx < 3; kx++)
            {
                int ix = ox * _Stride + kx - _Pad;
                int iy = oy * _Stride + ky - _Pad;
                if (ix < 0 || iy < 0 || ix >= _InW || iy >= _InH)
                    continue;

                uint inIdx = (uint)(ic * _InW * _InH + iy * _InW + ix);
                uint wIdx = (uint)(((oc * _InC + ic) * 3 + ky) * 3 + kx);
                sum += _ConvIn[inIdx] * _ConvW[wIdx];
            }
        }
    }

    if (_ActType == 2)
        sum = sum >= 0.0 ? sum : sum * _ActParam;

    _ConvOut[outIndex] = sum;
}

[numthreads(256,1,1)]
void NcnnTexToBuf3(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    uint w = (uint)_InW;
    uint h = (uint)_InH;
    uint n = w * h;
    if (idx >= n) return;
    uint x = idx % w;
    uint y = idx / w;
    int sx = (int)x + _OffsetX;
    int sy = (int)y + _OffsetY;
    uint tw, th;
    _NcnnIn.GetDimensions(tw, th);
    sx = clamp(sx, 0, (int)tw - 1);
    sy = clamp(sy, 0, (int)th - 1);
    float4 c = _NcnnIn[int2(sx, sy)];
    _BufOut[idx] = c.x;
    _BufOut[n + idx] = c.y;
    _BufOut[n * 2 + idx] = c.z;
}

[numthreads(8,8,1)]
void NcnnBufToTex3(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    uint idx = id.y * w + id.x;
    uint n = w * h;
    float r = _BufA[idx];
    float g = _BufA[n + idx];
    float b = _BufA[n * 2 + idx];
    _NcnnOut[int2(id.x, id.y)] = float4(r, g, b, 1.0);
}

[numthreads(256,1,1)]
void NcnnLeakyReluBuf(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    float v = _BufOut[idx];
    _BufOut[idx] = v >= 0.0 ? v : v * _CoeffA;
}

[numthreads(256,1,1)]
void NcnnAddWeighted(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_Total) return;
    _BufOut[idx] = _BufA[idx] * _CoeffA + _BufB[idx] * _CoeffB;
}

[numthreads(256,1,1)]
void NcnnCopyC(uint3 id : SV_DispatchThreadID)
{
    uint idx = _BaseIndex + id.x;
    if (idx >= (uint)_CopyTotal) return;
    uint wh = (uint)(_InW * _InH);
    uint ic = idx / wh;
    uint rem = idx - ic * wh;
    uint oc = ic + (uint)_ChanOffset;
    uint outIdx = oc * wh + rem;
    _BufOut[outIdx] = _BufA[idx];
}

[numthreads(64,1,1)]
void NcnnInterp2x(uint3 id : SV_DispatchThreadID)
{
    uint outIndex = _BaseIndex + id.x;
    uint inW = (uint)_InW;
    uint inH = (uint)_InH;
    uint inWH = inW * inH;
    uint outW = inW * 2;
    uint outH = inH * 2;
    uint outWH = outW * outH;
    uint outN = outWH * (uint)_InC;
    if (outIndex >= outN) return;

    uint c = outIndex / outWH;
    uint rem = outIndex - c * outWH;
    uint oy = rem / outW;
    uint ox = rem - oy * outW;

    float fx = ((float)ox + 0.5) * 0.5 - 0.5;
    float fy = ((float)oy + 0.5) * 0.5 - 0.5;
    int x0 = (int)floor(fx);
    int y0 = (int)floor(fy);
    int x1 = x0 + 1;
    int y1 = y0 + 1;
    float tx = fx - x0;
    float ty = fy - y0;
    x0 = clamp(x0, 0, (int)inW - 1);
    x1 = clamp(x1, 0, (int)inW - 1);
    y0 = clamp(y0, 0, (int)inH - 1);
    y1 = clamp(y1, 0, (int)inH - 1);

    uint baseC = c * inWH;
    float v00 = _BufA[baseC + (uint)(y0 * (int)inW + x0)];
    float v10 = _BufA[baseC + (uint)(y0 * (int)inW + x1)];
    float v01 = _BufA[baseC + (uint)(y1 * (int)inW + x0)];
    float v11 = _BufA[baseC + (uint)(y1 * (int)inW + x1)];
    float vx0 = lerp(v00, v10, tx);
    float vx1 = lerp(v01, v11, tx);
    float v = lerp(vx0, vx1, ty);
    _BufOut[outIndex] = v;
}

[numthreads(32,32,1)]
void NcnnBlitTileToDst(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _BlitW || (int)id.y >= _BlitH) return;

    int sx = (_DstX + (int)id.x) - _TileOutX;
    int sy = (_DstY + (int)id.y) - _TileOutY;
    float4 v = _NcnnInArr[int3(sx, sy, 0)];
    v.w = 1.0;
    _NcnnOut[int2(_DstX + (int)id.x, _DstY + (int)id.y)] = v;
}

[numthreads(8,8,1)]
void NcnnPassthrough(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    _NcnnOut[int2(id.x, id.y)] = _NcnnIn[int2(id.x, id.y)];
}
