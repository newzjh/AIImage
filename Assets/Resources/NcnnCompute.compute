        int sc = _SlicePack4Axis == 2 ? oc4.w + _SlicePack4Begin : oc4.w;
        o.w = NcnnReadPack4Channel(_SlicePack4InArr, x, y, sc);
    }

    _SlicePack4OutArr[int3((int)id.x, (int)id.y, p)] = o;
}

[numthreads(8,8,1)]
void NcnnPermutePack4(uint3 id : SV_DispatchThreadID)
