void NcnnConv3dPack4CDHWBody(uint3 id)
{
    uint ow, oh, od;
    _ConvOutArr.GetDimensions(ow, oh, od);
    int ox = (int)id.x * 2;
    int oy = (int)id.y * 2;
    int outPairCount = max(1, (_OutPacks + 1) / 2);
    int oz = (int)id.z / outPairCount;
    int op = ((int)id.z - oz * outPairCount) * 2;
    if (ox >= (int)ow || oy >= (int)oh || oz < 0 || oz >= _OutD || op < 0 || op >= _OutPacks) return;

    int globalOp = _OutPackOffset + op;
    int op1 = op + 1;
    bool hasOp1 = op1 < _OutPacks;
    int globalOp1 = _OutPackOffset + op1;
    bool hasX1 = (ox + 1) < (int)ow;
    bool hasY1 = (oy + 1) < (int)oh;
    float4 bias0 = _ConvB4[globalOp];
    float4 bias1 = hasOp1 ? _ConvB4[globalOp1] : 0.0;
    float4 sum00 = bias0;
    float4 sum01 = bias0;
    float4 sum10 = bias0;
    float4 sum11 = bias0;
    float4 sum20 = bias1;
    float4 sum21 = bias1;
    float4 sum30 = bias1;
    float4 sum31 = bias1;
    int kernelPlane = _KernelWVar * _KernelHVar;
    int kernelVolume = kernelPlane * _KernelDVar;

    for (int ip = 0; ip < _InPacks; ip++)
    {
        for (int kz = 0; kz < _KernelDVar; kz++)
        {
            int sz = oz * _StrideDVar - _PadFrontVar + kz * _DilationDVar;
            if (sz < 0 || sz >= _InD) continue;

            for (int ky = 0; ky < _KernelHVar; ky++)
            {
                int sy0 = oy * _StrideHVar - _PadTopVar + ky * _DilationHVar;
                int sy1 = sy0 + _StrideHVar;
                bool validY0 = sy0 >= 0 && sy0 < _InH;
                bool validY1 = hasY1 && sy1 >= 0 && sy1 < _InH;
                if (!validY0 && !validY1) continue;

                for (int kx = 0; kx < _KernelWVar; kx++)
                {
                    int sx0 = ox * _StrideWVar - _PadLeftVar + kx * _DilationWVar;
                    int sx1 = sx0 + _StrideWVar;
                    bool validX0 = sx0 >= 0 && sx0 < _InW;
                    bool validX1 = hasX1 && sx1 >= 0 && sx1 < _InW;
                    if (!validX0 && !validX1) continue;

                    int inSlice = sz * _InPacks + ip;
                    float4 v00 = (validX0 && validY0) ? _ConvInArr[int3(sx0, sy0, inSlice)] : 0.0;
                    float4 v01 = (validX1 && validY0) ? _ConvInArr[int3(sx1, sy0, inSlice)] : 0.0;
                    float4 v10 = (validX0 && validY1) ? _ConvInArr[int3(sx0, sy1, inSlice)] : 0.0;
                    float4 v11 = (validX1 && validY1) ? _ConvInArr[int3(sx1, sy1, inSlice)] : 0.0;
                    int kernelIndex = (kz * kernelPlane) + (ky * _KernelWVar) + kx;
                    int weightBase0 = ((((globalOp * _InPacks) + ip) * kernelVolume) + kernelIndex) * 4;
                    float4 w00 = _ConvW4[weightBase0 + 0];
                    float4 w01 = _ConvW4[weightBase0 + 1];
                    float4 w02 = _ConvW4[weightBase0 + 2];
                    float4 w03 = _ConvW4[weightBase0 + 3];
                    sum00.x += dot(v00, w00);
                    sum00.y += dot(v00, w01);
                    sum00.z += dot(v00, w02);
                    sum00.w += dot(v00, w03);
                    sum01.x += dot(v01, w00);
                    sum01.y += dot(v01, w01);
                    sum01.z += dot(v01, w02);
                    sum01.w += dot(v01, w03);
                    sum10.x += dot(v10, w00);
                    sum10.y += dot(v10, w01);
                    sum10.z += dot(v10, w02);
                    sum10.w += dot(v10, w03);
                    sum11.x += dot(v11, w00);
                    sum11.y += dot(v11, w01);
                    sum11.z += dot(v11, w02);
                    sum11.w += dot(v11, w03);

                    if (hasOp1)
                    {
                        int weightBase1 = ((((globalOp1 * _InPacks) + ip) * kernelVolume) + kernelIndex) * 4;
                        float4 w10 = _ConvW4[weightBase1 + 0];
                        float4 w11 = _ConvW4[weightBase1 + 1];
                        float4 w12 = _ConvW4[weightBase1 + 2];
                        float4 w13 = _ConvW4[weightBase1 + 3];
                        sum20.x += dot(v00, w10);
                        sum20.y += dot(v00, w11);
                        sum20.z += dot(v00, w12);
                        sum20.w += dot(v00, w13);
                        sum21.x += dot(v01, w10);
                        sum21.y += dot(v01, w11);
                        sum21.z += dot(v01, w12);
                        sum21.w += dot(v01, w13);
                        sum30.x += dot(v10, w10);
                        sum30.y += dot(v10, w11);
                        sum30.z += dot(v10, w12);
                        sum30.w += dot(v10, w13);
                        sum31.x += dot(v11, w10);
                        sum31.y += dot(v11, w11);
                        sum31.z += dot(v11, w12);
                        sum31.w += dot(v11, w13);
                    }
                }
            }
        }
    }

    int outSlice0 = oz * _OutPacks + op;
    sum00 = NcnnApplyActivation(sum00);
    if (hasX1) sum01 = NcnnApplyActivation(sum01);
    if (hasY1) sum10 = NcnnApplyActivation(sum10);
    if (hasX1 && hasY1) sum11 = NcnnApplyActivation(sum11);
    _ConvOutArr[int3(ox, oy, outSlice0)] = sum00;
    if (hasX1) _ConvOutArr[int3(ox + 1, oy, outSlice0)] = sum01;
    if (hasY1) _ConvOutArr[int3(ox, oy + 1, outSlice0)] = sum10;
    if (hasX1 && hasY1) _ConvOutArr[int3(ox + 1, oy + 1, outSlice0)] = sum11;

    if (!hasOp1)
        return;

    int outSlice1 = oz * _OutPacks + op1;
    sum20 = NcnnApplyActivation(sum20);
    if (hasX1) sum21 = NcnnApplyActivation(sum21);
    if (hasY1) sum30 = NcnnApplyActivation(sum30);
    if (hasX1 && hasY1) sum31 = NcnnApplyActivation(sum31);
    _ConvOutArr[int3(ox, oy, outSlice1)] = sum20;
    if (hasX1) _ConvOutArr[int3(ox + 1, oy, outSlice1)] = sum21;
    if (hasY1) _ConvOutArr[int3(ox, oy + 1, outSlice1)] = sum30;
    if (hasX1 && hasY1) _ConvOutArr[int3(ox + 1, oy + 1, outSlice1)] = sum31;
}

