    int3 bCoord = _BinaryPack4BroadcastMode == 2
        ? int3(0, 0, p)
        : int3((int)id.x, (int)id.y, p);

    float4 a = _BinaryA[aCoord];
    float4 b = _BinaryB[bCoord];

