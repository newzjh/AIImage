static float NcnnReadScalar2DLinear(uint linearIndex, int inW, int inH)
{
    if (inW <= 0 || inH <= 0)
        return 0.0;

    uint width = (uint)inW;
    uint x = linearIndex % width;
    uint y = linearIndex / width;
    if (y >= (uint)inH)
        return 0.0;

    return _ReshapeScalar2DInArr[int3((int)x, (int)y, 0)].x;
}

static float NcnnReadPack4LinearScalar2DInput(uint linearIndex, int inDims, int inW, int inH, int inD, int inC)
{
    if (inW <= 0 || inH <= 0 || inD <= 0 || inC <= 0)
        return 0.0;

    uint width = (uint)inW;
    uint x = linearIndex % width;
    uint index = linearIndex / width;

    if (inDims <= 1)
    {
        if (linearIndex >= width)
            return 0.0;
        return NcnnReadPack4Channel(_ReshapePack4ToScalar2DInArr, (int)linearIndex, 0, 0);
    }

    if (inDims == 2)
    {
        if (index >= (uint)inH)
            return 0.0;
        return _ReshapePack4ToScalar2DInArr[int3((int)x, (int)index, 0)].x;
    }

    uint height = (uint)inH;
    uint y = index % height;
    index /= height;

    if (inDims == 3)
    {
        if (index >= (uint)inC)
            return 0.0;
        return NcnnReadPack4Channel(_ReshapePack4ToScalar2DInArr, (int)x, (int)y, (int)index);
    }

    uint depth = (uint)max(1, inD);
    uint z = index % depth;
    uint c = index / depth;
    if (c >= (uint)inC)
        return 0.0;
    return NcnnReadPack4ChannelCDHW(_ReshapePack4ToScalar2DInArr, (int)x, (int)y, (int)z, (int)c, _ReshapePack4ToScalar2DInC);
}

static float NcnnReadPack4LinearPack4Input(uint linearIndex, int inDims, int inW, int inH, int inD, int inC)
{
    if (inW <= 0 || inH <= 0 || inD <= 0 || inC <= 0)
        return 0.0;

    uint width = (uint)inW;
    uint x = linearIndex % width;
    uint index = linearIndex / width;

    if (inDims <= 1)
    {
        if (linearIndex >= width)
            return 0.0;
        return NcnnReadPack4Channel(_ReshapePack4ToPack4InArr, (int)linearIndex, 0, 0);
    }

    if (inDims == 2)
    {
        if (index >= (uint)inH)
            return 0.0;
        return _ReshapePack4ToPack4InArr[int3((int)x, (int)index, 0)].x;
    }

    uint height = (uint)inH;
    uint y = index % height;
    index /= height;

    if (inDims == 3)
    {
        if (index >= (uint)inC)
            return 0.0;
        return NcnnReadPack4Channel(_ReshapePack4ToPack4InArr, (int)x, (int)y, (int)index);
    }

    uint depth = (uint)max(1, inD);
    uint z = index % depth;
    uint c = index / depth;
    if (c >= (uint)inC)
        return 0.0;
    return NcnnReadPack4ChannelCDHW(_ReshapePack4ToPack4InArr, (int)x, (int)y, (int)z, (int)c, _ReshapePack4ToPack4InC);
}

