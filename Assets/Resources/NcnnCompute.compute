    float4 v00 = _InterpDownInArr[int3(x0, y0, p)];
    float4 v10 = _InterpDownInArr[int3(x1, y0, p)];
    float4 v01 = _InterpDownInArr[int3(x0, y1, p)];
    float4 v11 = _InterpDownInArr[int3(x1, y1, p)];
    float4 vx0 = lerp(v00, v10, tx);
