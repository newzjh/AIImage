float4 NcnnApplyActivation(float4 v)
{
    if (_ActType == 1)
        v = max(v, 0.0);
    else if (_ActType == 2)
        v = max(v, 0.0) + min(v, 0.0) * _ActParam;
    else if (_ActType == 4)
        v = 1.0 / (1.0 + exp(-v));
    return v;
}

float NcnnApplyActivationScalar(float v)
{
    if (_ActType == 1)
        v = v >= 0.0 ? v : 0.0;
    else if (_ActType == 2)
        v = v >= 0.0 ? v : v * _ActParam;
    else if (_ActType == 4)
        v = 1.0 / (1.0 + exp(-v));
    return v;
}

void NcnnAccumulateDot4(inout float4 sum, float4 v, float4 w0, float4 w1, float4 w2, float4 w3)
{
    sum.x += dot(v, w0);
    sum.y += dot(v, w1);
    sum.z += dot(v, w2);
    sum.w += dot(v, w3);
}

