[numthreads(64,1,1)]
void NcnnMhaAttentionQkvFast(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    int q = (int)groupId.x;
    int head = (int)groupId.y;
    uint tid = groupThreadId.x;
    if (q < 0 || head < 0) return;
    if (q >= _MhaSrcLen || head >= _MhaNumHeads) return;
