float NcnnReadLane(float4 v, int lane)
{
    if (lane <= 0) return v.x;
    if (lane == 1) return v.y;
    if (lane == 2) return v.z;
    return v.w;
}

void NcnnWriteLane(inout float4 v, int lane, float value)
{
    if (lane <= 0) v.x = value;
    else if (lane == 1) v.y = value;
    else if (lane == 2) v.z = value;
    else v.w = value;
}

float NcnnReadPack4Channel(Texture2DArray<float4> tex, int x, int y, int channel)
{
    float4 v = tex[int3(x, y, channel / 4)];
    return NcnnReadLane(v, channel % 4);
}

float NcnnReadPack4ChannelCDHW(Texture2DArray<float4> tex, int x, int y, int z, int channel, int channelCount)
{
    int packCount = max(1, (channelCount + 3) / 4);
    int slice = z * packCount + channel / 4;
    float4 v = tex[int3(x, y, slice)];
    return NcnnReadLane(v, channel % 4);
}

