float4 NcnnReadInterpPack4CDHW(int x, int y, int z, int pack, int srcW, int srcH, int srcD, int srcPacks)
{
    x = clamp(x, 0, max(0, srcW - 1));
    y = clamp(y, 0, max(0, srcH - 1));
    z = clamp(z, 0, max(0, srcD - 1));
    pack = clamp(pack, 0, max(0, srcPacks - 1));
    return _InterpInArr[int3(x, y, z * srcPacks + pack)];
