    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _InterpNnInArr.GetDimensions(iw, ih, idd);
    int sx = min((int)(id.x >> 1), (int)iw - 1);
    int sy = min((int)(id.y >> 1), (int)ih - 1);
    _InterpNnOutArr[int3((int)id.x, (int)id.y, p)] = _InterpNnInArr[int3(sx, sy, p)];
}

