    float4 bestValue = float4(-3.402823466e+38, -3.402823466e+38, -3.402823466e+38, -3.402823466e+38);
    float4 bestIndex = float4(-1.0, -1.0, -1.0, -1.0);

    for (int ky = 0; ky < _PoolKernelH; ky++)
