int _EmbedInputDim;
int _EmbedBiasTerm;

static int Reflect101(int x, int len)
{
    if (len <= 1) return 0;
    while (x < 0 || x >= len)
    {
        if (x < 0) x = -x;
        if (x >= len) x = (len - 1) * 2 - x;
    }
    return x;
}

[numthreads(1,1,1)]
void NcnnProbeTilePack4(uint3 id : SV_DispatchThreadID)
{
    uint iw, ih, idd;
    _ProbeInArr.GetDimensions(iw, ih, idd);
    if (idd == 0) return;
    int pad = max(0, _ProbePad);
    int cw = max(1, _ProbeCoreW);
    int ch = max(1, _ProbeCoreH);
    int x0 = clamp(pad, 0, (int)iw - 1);
    int y0 = clamp(pad, 0, (int)ih - 1);
    int x1 = clamp(pad + cw - 1, 0, (int)iw - 1);
    int y1 = clamp(pad + ch - 1, 0, (int)ih - 1);
    int spanX = max(1, x1 - x0);
    int spanY = max(1, y1 - y0);

    float4 sum = 0.0;
    [unroll]
    for (int uy = 0; uy < 4; uy++)
    {
        int sy = y0 + ((uy + 1) * spanY) / 5;
        [unroll]
        for (int ux = 0; ux < 4; ux++)
        {
            int sx = x0 + ((ux + 1) * spanX) / 5;
            sum += _ProbeInArr[int3(sx, sy, 0)];
        }
    }
    _ProbeOut[_ProbeIndex] = sum * (1.0 / 16.0);
}

[numthreads(64,1,1)]
void NcnnProbeSeams(uint3 id : SV_DispatchThreadID)
{
    int seamsV = max(0, _SeamTilesX - 1);
    int seamsH = max(0, _SeamTilesY - 1);
    int seamCount = seamsV + seamsH;
    int i = (int)id.x;
    if (i < 0 || i >= seamCount) return;

    int samples = max(4, _SeamSamples);
    float sumScore = 0.0;
    int valid = 0;

    if (i < seamsV)
    {
        int seamX = (i + 1) * _SeamStepX;
        if (seamX - 2 < 0 || seamX + 1 >= _SeamW) { _SeamOut4[i] = float4(0.0, 0.0, (float)seamX, 0.0); return; }

        [loop]
        for (int s = 0; s < samples; s++)
        {
            int y = (int)((((float)s + 0.5) / (float)samples) * (float)(_SeamH - 1));
            y = clamp(y, 0, _SeamH - 1);
            float3 cLL = _SeamTex[int2(seamX - 2, y)].xyz;
            float3 cL  = _SeamTex[int2(seamX - 1, y)].xyz;
            float3 cR  = _SeamTex[int2(seamX + 0, y)].xyz;
            float3 cRR = _SeamTex[int2(seamX + 1, y)].xyz;
            float d0 = abs(cL.x - cR.x) + abs(cL.y - cR.y) + abs(cL.z - cR.z);
            float d1 = abs(cLL.x - cL.x) + abs(cLL.y - cL.y) + abs(cLL.z - cL.z);
            float d2 = abs(cR.x - cRR.x) + abs(cR.y - cRR.y) + abs(cR.z - cRR.z);
            float local = 0.5 * (d1 + d2);
            sumScore += max(0.0, d0 - local);
            valid++;
        }

        float score = valid > 0 ? (sumScore / (float)valid) : 0.0;
        _SeamOut4[i] = float4(score, 0.0, (float)seamX, 0.0);
        return;
    }

    int j = i - seamsV;
    int seamY = (j + 1) * _SeamStepY;
    if (seamY - 2 < 0 || seamY + 1 >= _SeamH) { _SeamOut4[i] = float4(0.0, 1.0, (float)seamY, 0.0); return; }

    [loop]
    for (int s = 0; s < samples; s++)
    {
        int x = (int)((((float)s + 0.5) / (float)samples) * (float)(_SeamW - 1));
        x = clamp(x, 0, _SeamW - 1);
        float3 cUU = _SeamTex[int2(x, seamY - 2)].xyz;
        float3 cU  = _SeamTex[int2(x, seamY - 1)].xyz;
        float3 cD  = _SeamTex[int2(x, seamY + 0)].xyz;
        float3 cDD = _SeamTex[int2(x, seamY + 1)].xyz;
        float d0 = abs(cU.x - cD.x) + abs(cU.y - cD.y) + abs(cU.z - cD.z);
        float d1 = abs(cUU.x - cU.x) + abs(cUU.y - cU.y) + abs(cUU.z - cU.z);
        float d2 = abs(cD.x - cDD.x) + abs(cD.y - cDD.y) + abs(cD.z - cDD.z);
        float local = 0.5 * (d1 + d2);
        sumScore += max(0.0, d0 - local);
        valid++;
    }

    float score = valid > 0 ? (sumScore / (float)valid) : 0.0;
    _SeamOut4[i] = float4(score, 1.0, (float)seamY, 0.0);
}

[numthreads(8,8,1)]
void NcnnPaddingPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _PadOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _PadInArr.GetDimensions(iw, ih, idd);
    int sx = (int)id.x - _PadLeft;
    int sy = (int)id.y - _PadTop;

    if (_PadType == 0)
    {
        if (sx < 0 || sy < 0 || sx >= (int)iw || sy >= (int)ih || p >= (int)idd)
        {
            _PadOutArr[int3((int)id.x, (int)id.y, p)] = _PadValue4;
            return;
        }
        _PadOutArr[int3((int)id.x, (int)id.y, p)] = _PadInArr[int3(sx, sy, p)];
        return;
    }

    if (sx < 0 || sx >= (int)iw)
    {
        if (_PadType == 1)
            sx = clamp(sx, 0, (int)iw - 1);
        else
            sx = Reflect101(sx, (int)iw);
    }
    if (sy < 0 || sy >= (int)ih)
    {
        if (_PadType == 1)
            sy = clamp(sy, 0, (int)ih - 1);
        else
            sy = Reflect101(sy, (int)ih);
    }
    int sp = p;
    if (sp >= (int)idd) sp = (int)idd - 1;
    _PadOutArr[int3((int)id.x, (int)id.y, p)] = _PadInArr[int3(sx, sy, sp)];
}

[numthreads(8,8,1)]
void NcnnPoolingPack4(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _PoolOutArr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)od) return;

    uint iw, ih, idd;
    _PoolInArr.GetDimensions(iw, ih, idd);
    int ox = (int)id.x;
    int oy = (int)id.y;

    int sx0 = ox * _PoolStrideW - _PoolPadLeft;
    int sy0 = oy * _PoolStrideH - _PoolPadTop;
    int sx1 = sx0 + _PoolKernelW;
    int sy1 = sy0 + _PoolKernelH;

    float4 acc;
    if (_PoolType == 0)
        acc = float4(-3.402823466e+38, -3.402823466e+38, -3.402823466e+38, -3.402823466e+38);
    else
        acc = 0.0;

    int count = 0;
    for (int yy = sy0; yy < sy1; yy++)
    {
        for (int xx = sx0; xx < sx1; xx++)
        {
            if (xx < 0 || yy < 0 || xx >= (int)iw || yy >= (int)ih) continue;
            if (p >= (int)idd) continue;
            float4 v = _PoolInArr[int3(xx, yy, p)];
            if (_PoolType == 0)
                acc = max(acc, v);
            else
            {
                acc += v;
                count++;
            }
        }
    }

    if (_PoolType != 0)
    {
        float inv = count > 0 ? (1.0 / (float)count) : 0.0;
        acc *= inv;
    }

    _PoolOutArr[int3(ox, oy, p)] = acc;
}

[numthreads(8,8,1)]
void NcnnSoftmaxChannelPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _SoftmaxOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;

    float4 v = _SoftmaxInArr[int3((int)id.x, (int)id.y, p)];

    float maxv = -3.402823466e+38;
    for (int ip = 0; ip < _SoftmaxPacks; ip++)
    {
        float4 t = _SoftmaxInArr[int3((int)id.x, (int)id.y, ip)];
        maxv = max(maxv, max(max(t.x, t.y), max(t.z, t.w)));
    }

    float sum = 0.0;
    for (int ip = 0; ip < _SoftmaxPacks; ip++)
    {
        float4 t = _SoftmaxInArr[int3((int)id.x, (int)id.y, ip)];
        float4 e = exp(t - maxv);
        sum += e.x + e.y + e.z + e.w;
    }
    float inv = sum > 0.0 ? (1.0 / sum) : 0.0;
    float4 o = exp(v - maxv) * inv;
    _SoftmaxOutArr[int3((int)id.x, (int)id.y, p)] = o;
}

[numthreads(8,8,1)]
void NcnnUnaryOpPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _UnaryOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 x = _UnaryInArr[int3((int)id.x, (int)id.y, p)];
    float4 y = x;
    int t = _UnaryOpType;
    if (t == 0) y = abs(x);
    else if (t == 1) y = -x;
    else if (t == 2) y = floor(x);
    else if (t == 3) y = ceil(x);
    else if (t == 4) y = x * x;
    else if (t == 5) y = sqrt(max(x, 0.0));
    else if (t == 6) y = rsqrt(max(x, 1e-12));
    else if (t == 7) y = exp(x);
    else if (t == 8) y = log(max(x, 1e-12));
    else if (t == 9) y = sin(x);
    else if (t == 10) y = cos(x);
    else if (t == 11) y = tan(x);
    else if (t == 15) y = 1.0 / max(x, 1e-12);
    else if (t == 16) y = tanh(x);
    _UnaryOutArr[int3((int)id.x, (int)id.y, p)] = y;
}

[numthreads(8,8,1)]
void NcnnBinaryOpPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _BinaryOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;

    float4 a = _BinaryA[int3((int)id.x, (int)id.y, p)];
    float4 b = _BinaryWithScalar != 0 ? _BinaryScalar : _BinaryB[int3((int)id.x, (int)id.y, p)];

    float4 o = a;
    int t = _BinaryOpType;
    if (t == 0) o = a + b;
    else if (t == 1) o = a - b;
    else if (t == 2) o = a * b;
    else if (t == 3) o = a / max(b, 1e-12);
    else if (t == 4) o = max(a, b);
    else if (t == 5) o = min(a, b);
    else if (t == 6) o = pow(abs(a), b);
    else if (t == 7) o = b - a;
    else if (t == 8) o = b / max(a, 1e-12);
    else if (t == 9) o = pow(abs(b), a);
    _BinaryOutArr[int3((int)id.x, (int)id.y, p)] = o;
}

[numthreads(8,8,1)]
void NcnnSwishPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ActOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 x = _ActInArr[int3((int)id.x, (int)id.y, p)];
    float4 y = x / (1.0 + exp(-x));
    _ActOutArr[int3((int)id.x, (int)id.y, p)] = y;
}

[numthreads(8,8,1)]
void NcnnSigmoidPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ActOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 x = _ActInArr[int3((int)id.x, (int)id.y, p)];
    float4 y = 1.0 / (1.0 + exp(-x));
    _ActOutArr[int3((int)id.x, (int)id.y, p)] = y;
}

[numthreads(8,8,1)]
void NcnnGeluPack4(uint3 id : SV_DispatchThreadID)
{
    uint w, h, d;
    _ActOutArr.GetDimensions(w, h, d);
    if (id.x >= w || id.y >= h) return;
    int p = (int)id.z;
    if (p < 0 || p >= (int)d) return;
    float4 x = _ActInArr[int3((int)id.x, (int)id.y, p)];
    float4 y = x;
    if (_GeluFast != 0)
    {
        float4 x3 = x * x * x;
        y = 0.5 * x * (1.0 + tanh(0.79788452 * (x + 0.044715 * x3)));
    }
    _ActOutArr[int3((int)id.x, (int)id.y, p)] = y;
}

[numthreads(8,8,1)]
void NcnnEmbed(uint3 id : SV_DispatchThreadID)
{
    int p = (int)id.x;
    int q = (int)id.y;
    if (q < 0 || p < 0 || q >= _EmbedWords || p >= _EmbedNumOutput) return;

    int word_index = _EmbedIdx[q];
    word_index = clamp(word_index, 0, _EmbedInputDim - 1);
    float v = _EmbedW[word_index * _EmbedNumOutput + p];
    if (_EmbedBiasTerm != 0)
        v += _EmbedB[p];
    _EmbedOut[q * _EmbedNumOutput + p] = v;
}

groupshared float _Red0[256];
groupshared float _Red1[256];

[numthreads(256,1,1)]
void NcnnLayerNorm2D(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    int row = (int)groupId.x;
    if (row < 0 || row >= _LnRows) return;
    int tid = (int)groupThreadId.x;
    int cols = max(1, _LnCols);
    int baseIndex = row * cols;

    float sum = 0.0;
    float sqsum = 0.0;
    for (int col = tid; col < cols; col += 256)
    {
        float x = _LnInOut[baseIndex + col];
        sum += x;
        sqsum += x * x;
    }

    _Red0[tid] = sum;
    _Red1[tid] = sqsum;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (int stride = 128; stride > 0; stride >>= 1)
    {
        if (tid < stride)
        {
            _Red0[tid] += _Red0[tid + stride];
            _Red1[tid] += _Red1[tid + stride];
        }
        GroupMemoryBarrierWithGroupSync();
    }

    float mean = _Red0[0] / cols;
    float var = _Red1[0] / cols - mean * mean;
    float invstd = rsqrt(max(var + _LnEps, 1e-20));

    for (int col = tid; col < cols; col += 256)
    {
        float x = _LnInOut[baseIndex + col];
        float y = (x - mean) * invstd;
        if (_LnAffine != 0)
            y = y * _LnGamma[col] + _LnBeta[col];
        _LnInOut[baseIndex + col] = y;
    }
}

[numthreads(256,1,1)]
void NcnnSoftmax2D(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    int row = (int)groupId.x;
    if (row < 0 || row >= _SoftRows) return;
    int tid = (int)groupThreadId.x;
    int cols = max(1, _SoftCols);
    int baseIndex = row * cols;

    float maxv = -3.402823466e+38;
    for (int col = tid; col < cols; col += 256)
    {
        float x = _SoftIn[baseIndex + col];
        maxv = max(maxv, x);
    }
    _Red0[tid] = maxv;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (int stride = 128; stride > 0; stride >>= 1)
    {
        if (tid < stride)
            _Red0[tid] = max(_Red0[tid], _Red0[tid + stride]);
        GroupMemoryBarrierWithGroupSync();
    }
    float rowMax = _Red0[0];

    float sum = 0.0;
    for (int col = tid; col < cols; col += 256)
    {
        float e = exp(_SoftIn[baseIndex + col] - rowMax);
        sum += e;
        _SoftOut[baseIndex + col] = e;
    }
    _Red1[tid] = sum;
    GroupMemoryBarrierWithGroupSync();

    [unroll]
    for (int stride = 128; stride > 0; stride >>= 1)
    {
        if (tid < stride)
            _Red1[tid] += _Red1[tid + stride];
        GroupMemoryBarrierWithGroupSync();
    }
    float invSum = 1.0 / max(_Red1[0], 1e-20);

    for (int col = tid; col < cols; col += 256)
    {
        _SoftOut[baseIndex + col] = _SoftOut[baseIndex + col] * invSum;
    }
}

[numthreads(8,8,1)]
void NcnnMatMul2D(uint3 id : SV_DispatchThreadID)
{
    int j = (int)id.x;
    int i = (int)id.y;
    if (i < 0 || j < 0 || i >= _MatM || j >= _MatN) return;
    float sum = 0.0;
    int aBase = i * _MatK;
    for (int k = 0; k < _MatK; k++)
    {
        float a = _MatA[aBase + k];
        float b;
        if (_MatTransB != 0)
            b = _MatB[j * _MatK + k];
        else
            b = _MatB[k * _MatN + j];
        sum += a * b;
    }
    _MatOut[i * _MatN + j] = sum;
}

[numthreads(8,8,1)]
void NcnnGemm2D(uint3 id : SV_DispatchThreadID)
{
    int j = (int)id.x;
    int i = (int)id.y;
    if (i < 0 || j < 0 || i >= _MatM || j >= _MatN) return;

    float sum = 0.0;
    if (_MatUseC != 0)
    {
        if (_MatBroadcastTypeC == 0)
            sum = _MatC[0];
        else if (_MatBroadcastTypeC == 1)
            sum = _MatC[i];
        else if (_MatBroadcastTypeC == 3)
            sum = _MatC[i * _MatN + j];
        else if (_MatBroadcastTypeC == 4)
            sum = _MatC[j];
        sum *= _MatBeta;
    }

    int aBase = i * _MatK;
    float acc = 0.0;
    for (int k = 0; k < _MatK; k++)
    {
        float a = _MatA[aBase + k];
        float b;
        if (_MatTransB != 0)
            b = _MatB[j * _MatK + k];
        else
            b = _MatB[k * _MatN + j];
        acc += a * b;
    }
    sum += acc * _MatAlpha;
    _MatOut[i * _MatN + j] = sum;
}

[numthreads(8,8,1)]
void NcnnPassthrough(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NcnnOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    _NcnnOut[int2(id.x, id.y)] = _NcnnIn[int2(id.x, id.y)];
}
