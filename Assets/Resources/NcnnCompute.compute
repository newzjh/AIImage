RWTexture2DArray<float4> _SoftmaxOutArr;
int _SoftmaxPacks;

Texture2DArray<float4> _UnaryInArr;
RWTexture2DArray<float4> _UnaryOutArr;
int _UnaryOpType;

Texture2DArray<float4> _BinaryA;
Texture2DArray<float4> _BinaryB;
RWTexture2DArray<float4> _BinaryOutArr;
int _BinaryOpType;
int _BinaryWithScalar;
float _BinaryScalar;

Texture2DArray<float4> _ActInArr;
RWTexture2DArray<float4> _ActOutArr;
int _GeluFast;

