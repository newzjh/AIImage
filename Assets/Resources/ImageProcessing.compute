#pragma kernel ResizeBilinear
#pragma kernel BilateralFilter
#pragma kernel RemoveWatermark
#pragma kernel AdjustContrast
#pragma kernel AdjustBrightness
#pragma kernel AdjustVibrance
#pragma kernel AdjustShadows
#pragma kernel AdjustHighlights
#pragma kernel WarmFilter
#pragma kernel CoolFilter
#pragma kernel Sharpen
#pragma kernel Blur
#pragma kernel PasteRectWithMask

Texture2D<float4> _Source;
Texture2D<float4> _Overlay;
Texture2D<float> _FaceMaskIn;
RWTexture2D<float4> _Result;

float4 _SrcSize;
float4 _DstSize;
int4 _CropRect;

float4 SampleBilinearOverlay(float2 uv)
{
    uint ow, oh;
    _Overlay.GetDimensions(ow, oh);
    if (ow == 0 || oh == 0) return 0;

    float2 size = float2(ow, oh);
    float2 src = uv * size - 0.5;
    int2 p0 = int2(floor(src));
    float2 f = frac(src);

    int2 p00 = clamp(p0, int2(0,0), int2(size) - 1);
    int2 p10 = clamp(p0 + int2(1,0), int2(0,0), int2(size) - 1);
    int2 p01 = clamp(p0 + int2(0,1), int2(0,0), int2(size) - 1);
    int2 p11 = clamp(p0 + int2(1,1), int2(0,0), int2(size) - 1);

    float4 c00 = _Overlay[p00];
    float4 c10 = _Overlay[p10];
    float4 c01 = _Overlay[p01];
    float4 c11 = _Overlay[p11];

    float4 cx0 = lerp(c00, c10, f.x);
    float4 cx1 = lerp(c01, c11, f.x);
    return lerp(cx0, cx1, f.y);
}

float _SigmaSpatial;
float _SigmaRange;
int _Radius;

float4 _WatermarkRect; // x,y,w,h in normalized [0..1]

float _Contrast;   // [-1..1]
float _Brightness; // [-1..1]
float _Vibrance;   // [-1..1]
float _Shadows;    // [0..1]
float _Highlights; // [0..1]
float _Warm;       // [0..1]
float _Cool;       // [0..1]
float _Sharpen;    // [0..1]
float _Blur;       // [0..1]

static const float3 kLuma = float3(0.2126, 0.7152, 0.0722);

float3 Clamp01(float3 v)
{
    return saturate(v);
}

float3 ApplyContrast(float3 c, float amount)
{
    float f = 1.0 + amount;
    return (c - 0.5) * f + 0.5;
}

float3 ApplyBrightness(float3 c, float amount)
{
    return c + amount;
}

float3 ApplySaturation(float3 c, float amount)
{
    float l = dot(c, kLuma);
    float3 g = l.xxx;
    return lerp(g, c, 1.0 + amount);
}

float3 ApplyVibrance(float3 c, float amount)
{
    float maxC = max(c.r, max(c.g, c.b));
    float minC = min(c.r, min(c.g, c.b));
    float sat = maxC - minC;
    float adj = (amount >= 0.0) ? amount * (1.0 - sat) : amount;
    return ApplySaturation(c, adj);
}

float3 ApplyShadows(float3 c, float amount)
{
    float l = dot(c, kLuma);
    float mask = saturate((0.5 - l) / 0.5);
    return c + mask * amount * (1.0 - c);
}

float3 ApplyHighlights(float3 c, float amount)
{
    float l = dot(c, kLuma);
    float mask = saturate((l - 0.5) / 0.5);
    return c - mask * amount * c;
}

float3 ApplyWarm(float3 c, float amount)
{
    float3 t = c;
    t.r += amount * 0.10;
    t.g += amount * 0.02;
    t.b -= amount * 0.08;
    return t;
}

float3 ApplyCool(float3 c, float amount)
{
    float3 t = c;
    t.r -= amount * 0.08;
    t.g -= amount * 0.02;
    t.b += amount * 0.10;
    return t;
}

[numthreads(8,8,1)]
void ResizeBilinear(uint3 id : SV_DispatchThreadID)
{
    uint dstW, dstH;
    _Result.GetDimensions(dstW, dstH);
    if (id.x >= dstW || id.y >= dstH) return;

    float2 srcSize = float2(_SrcSize.x, _SrcSize.y);
    float2 dstSize = float2(dstW, dstH);

    float2 uv = (float2(id.x, id.y) + 0.5) / dstSize;
    float2 src = uv * srcSize - 0.5;

    int2 p0 = int2(floor(src));
    float2 f = frac(src);

    int2 p00 = clamp(p0, int2(0,0), int2(srcSize) - 1);
    int2 p10 = clamp(p0 + int2(1,0), int2(0,0), int2(srcSize) - 1);
    int2 p01 = clamp(p0 + int2(0,1), int2(0,0), int2(srcSize) - 1);
    int2 p11 = clamp(p0 + int2(1,1), int2(0,0), int2(srcSize) - 1);

    float4 c00 = _Source[p00];
    float4 c10 = _Source[p10];
    float4 c01 = _Source[p01];
    float4 c11 = _Source[p11];

    float4 cx0 = lerp(c00, c10, f.x);
    float4 cx1 = lerp(c01, c11, f.x);
    float4 c = lerp(cx0, cx1, f.y);
    _Result[int2(id.xy)] = c;
}

[numthreads(8,8,1)]
void PasteRectWithMask(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int x = (int)id.x;
    int y = (int)id.y;

    float4 src = _Source[int2(x, y)];

    int rx = _CropRect.x;
    int ry = _CropRect.y;
    int rw = _CropRect.z;
    int rh = _CropRect.w;

    bool inside = (x >= rx) && (y >= ry) && (x < rx + rw) && (y < ry + rh);
    if (!inside)
    {
        _Result[int2(x, y)] = src;
        return;
    }

    float2 uv = (float2((x - rx), (y - ry)) + 0.5) / float2(max(1, rw), max(1, rh));
    float4 over = SampleBilinearOverlay(uv);

    float a = 1.0;
    a = _FaceMaskIn[int2(x, y)];
    a = saturate(a);

    float3 rgb = lerp(src.rgb, over.rgb, a);
    _Result[int2(x, y)] = float4(rgb, src.a);
}

[numthreads(8,8,1)]
void BilateralFilter(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float4 center = _Source[p];

    float sigmaS = max(0.001, _SigmaSpatial);
    float sigmaR = max(0.001, _SigmaRange);
    float inv2SigmaS2 = 0.5 / (sigmaS * sigmaS);
    float inv2SigmaR2 = 0.5 / (sigmaR * sigmaR);

    int r = max(1, _Radius);

    float4 sum = 0;
    float wsum = 0;

    for (int dy = -r; dy <= r; dy++)
    {
        for (int dx = -r; dx <= r; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), int2(int(w)-1, int(h)-1));
            float4 c = _Source[q];

            float ds2 = dx * dx + dy * dy;
            float4 diff = c - center;
            float dr2 = dot(diff.rgb, diff.rgb);

            float ws = exp(-ds2 * inv2SigmaS2);
            float wr = exp(-dr2 * inv2SigmaR2);
            float ww = ws * wr;

            sum += c * ww;
            wsum += ww;
        }
    }

    _Result[p] = sum / max(1e-6, wsum);
}

[numthreads(8,8,1)]
void RemoveWatermark(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float2 uv = (float2(id.x, id.y) + 0.5) / float2(w, h);
    float2 rectMin = _WatermarkRect.xy;
    float2 rectMax = _WatermarkRect.xy + _WatermarkRect.zw;

    float4 c = _Source[int2(id.xy)];
    if (uv.x >= rectMin.x && uv.x <= rectMax.x && uv.y >= rectMin.y && uv.y <= rectMax.y)
    {
        int r = max(2, _Radius);
        float4 sum = 0;
        float wsum = 0;
        int2 p = int2(id.xy);

        for (int dy = -r; dy <= r; dy++)
        {
            for (int dx = -r; dx <= r; dx++)
            {
                float2 uv2 = (float2(p.x + dx, p.y + dy) + 0.5) / float2(w, h);
                if (uv2.x >= rectMin.x && uv2.x <= rectMax.x && uv2.y >= rectMin.y && uv2.y <= rectMax.y)
                    continue;

                int2 q = clamp(p + int2(dx, dy), int2(0,0), int2(int(w)-1, int(h)-1));
                float ds2 = dx * dx + dy * dy;
                float ww = exp(-ds2 * 0.08);
                sum += _Source[q] * ww;
                wsum += ww;
            }
        }

        if (wsum > 1e-5)
            c = sum / wsum;
    }

    _Result[int2(id.xy)] = c;
}

[numthreads(8,8,1)]
void AdjustContrast(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyContrast(p.rgb, _Contrast));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void AdjustBrightness(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyBrightness(p.rgb, _Brightness));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void AdjustVibrance(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyVibrance(p.rgb, _Vibrance));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void AdjustShadows(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyShadows(p.rgb, _Shadows));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void AdjustHighlights(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyHighlights(p.rgb, _Highlights));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void WarmFilter(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyWarm(p.rgb, _Warm));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void CoolFilter(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    float4 p = _Source[int2(id.xy)];
    p.rgb = Clamp01(ApplyCool(p.rgb, _Cool));
    _Result[int2(id.xy)] = p;
}

[numthreads(8,8,1)]
void Sharpen(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    int2 left = int2(max(p.x - 1, 0), p.y);
    int2 right = int2(min(p.x + 1, int(w) - 1), p.y);
    int2 up = int2(p.x, max(p.y - 1, 0));
    int2 down = int2(p.x, min(p.y + 1, int(h) - 1));

    float4 c = _Source[p];
    float3 avg = (_Source[left].rgb + _Source[right].rgb + _Source[up].rgb + _Source[down].rgb) * 0.25;
    float amount = saturate(_Sharpen * 2.0);
    float3 outRgb = c.rgb + amount * (c.rgb - avg);
    c.rgb = Clamp01(outRgb);
    _Result[p] = c;
}

[numthreads(8,8,1)]
void Blur(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float4 center = _Source[p];

    float amount = saturate(_Blur * 2.0);
    int r = 1 + (int)round(amount * 2.0); // 1..3
    float sigma = max(0.5, r * 0.8);
    float inv2Sigma2 = 0.5 / (sigma * sigma);

    float3 sum = 0;
    float wsum = 0;
    for (int dy = -r; dy <= r; dy++)
    {
        for (int dx = -r; dx <= r; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), int2(int(w)-1, int(h)-1));
            float ds2 = (float)(dx * dx + dy * dy);
            float ww = exp(-ds2 * inv2Sigma2);
            sum += _Source[q].rgb * ww;
            wsum += ww;
        }
    }

    float3 blurred = sum / max(1e-6, wsum);
    center.rgb = Clamp01(lerp(center.rgb, blurred, amount));
    _Result[p] = center;
}
