float AexisGnApplyOne(float x, int c)
{
    if (c < 0 || c >= _GnC)
        return 0.0;
    int g = c / max(1, _GnChannelsG);
    float2 stats = _GnStatsOut[g].xy;
    float centered = x - stats.x;
    float y = _GnMvnMode == 2 ? centered
        : _GnMvnMode == 1 ? centered / max(sqrt(max(stats.y, 0.0)) + _GnEps, 1e-20)
        : centered * rsqrt(max(stats.y + _GnEps, 1e-20));
    if (_GnAffine != 0)
        y = y * _GnGamma[c] + _GnBeta[c];
    return y;
}

