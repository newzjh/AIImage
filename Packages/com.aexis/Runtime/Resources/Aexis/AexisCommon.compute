[numthreads(8,8,1)]
void AexisReshapeLinearMat2D(uint3 id : SV_DispatchThreadID)
{
    uint outW, outH;
    _LinearOut0.GetDimensions(outW, outH);
    if (id.x >= outW || id.y >= outH)
        return;
    int linearIndex = (int)id.y * (int)outW + (int)id.x;
    int sourceY = linearIndex / max(1, _LinearReshapeInW);
    int sourceX = linearIndex - sourceY * _LinearReshapeInW;
    _LinearOut0[int2(id.xy)] = sourceY < _LinearReshapeInH ? _LinearIn0[int2(sourceX, sourceY)] : 0.0;
}

