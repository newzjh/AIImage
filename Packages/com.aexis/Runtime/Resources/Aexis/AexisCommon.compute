[numthreads(8,8,1)]
void AexisRmsNormPack4LinearMat(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh, od;
    _TexOut0Arr.GetDimensions(ow, oh, od);
    if (id.x >= ow || id.y >= oh || id.z >= od)
        return;

    int logicalWidth = max(1, _RmsNormW);
    int packBase = (int)id.x * 4;
    float sumSquare = 0.0;
    for (int i = 0; i < logicalWidth; ++i)
    {
        float4 packed = _TexIn0Arr[int3(i / 4, (int)id.y, 0)];
        float value = AexisReadLane(packed, i & 3);
        sumSquare += value * value;
    }

    float invRms = rsqrt(max(sumSquare / logicalWidth + _RmsNormEps, 1e-20));
    float4 src = _TexIn0Arr[int3((int)id.x, (int)id.y, 0)];
    float4 dst = 0.0;
    [unroll]
    for (int lane = 0; lane < 4; ++lane)
    {
        int innerIndex = packBase + lane;
        if (innerIndex >= logicalWidth)
            continue;
        float value = AexisReadLane(src, lane) * invRms;
        if (_RmsNormAffine != 0 && _RmsNormAffineSize > 0)
            value *= _RmsNormGamma[clamp(innerIndex, 0, _RmsNormAffineSize - 1)];
        AexisWriteLane(dst, lane, value);
    }
    _TexOut0Arr[int3((int)id.x, (int)id.y, 0)] = dst;
}

