float AexisRoundToNearest(float v)
{
    return v >= 0.0 ? floor(v + 0.5) : ceil(v - 0.5);
}

float AexisComputeNormAlpha(float sumSquare)
{
    if (_NormEpsMode == 1)
        return 1.0 / max(sqrt(sumSquare), _NormEps);
    if (_NormEpsMode == 2)
        return rsqrt(max(sumSquare, _NormEps));
    return rsqrt(sumSquare + _NormEps);
}

float AexisResolveNormScale(int channel)
{
    if (_NormScaleSize <= 0)
        return 1.0;
    if (_NormChannelShared != 0 || _NormScaleSize == 1)
        return _NormScale[0];
    return _NormScale[clamp(channel, 0, _NormScaleSize - 1)];
}

void AexisDecodeRmsNormSegment(int idx, out int segmentBase, out int segmentSize, out int innerIndex)
{
    int w = max(1, _RmsNormW);
    int h = max(1, _RmsNormH);
    int d = max(1, _RmsNormD);
    int plane = w * h;
    int volume = plane * d;

    if (_RmsNormDims <= 1)
    {
        segmentBase = 0;
        segmentSize = w;
        innerIndex = idx;
        return;
    }

    if (_RmsNormDims == 2)
    {
        int row = idx / w;
        segmentBase = row * w;
        segmentSize = w;
        innerIndex = idx - segmentBase;
        return;
    }

    if (_RmsNormDims == 3)
    {
        int q = idx / plane;
        int rem = idx - q * plane;

        if (_RmsNormAffineSize == w)
        {
            int row = rem / w;
            segmentBase = (q * h + row) * w;
            segmentSize = w;
            innerIndex = rem - row * w;
            return;
        }

        segmentBase = q * plane;
        segmentSize = plane;
        innerIndex = rem;
        return;
    }

    int q4 = idx / volume;
    int rem4 = idx - q4 * volume;

    if (_RmsNormAffineSize == w)
    {
        int z = rem4 / plane;
        int remPlane = rem4 - z * plane;
        int row = remPlane / w;
        segmentBase = ((q4 * d + z) * h + row) * w;
        segmentSize = w;
        innerIndex = remPlane - row * w;
        return;
    }

    if (_RmsNormAffineSize == plane)
    {
        int z = rem4 / plane;
        int remPlane = rem4 - z * plane;
        segmentBase = (q4 * d + z) * plane;
        segmentSize = plane;
        innerIndex = remPlane;
        return;
    }

    segmentBase = q4 * volume;
    segmentSize = volume;
    innerIndex = rem4;
}

