// Recurrent NCNN operators. These bindings are texture-only for
// activations and caches; the only StructuredBuffer use is immutable debug-free
// metadata/weights in future quantized variants.
Texture2DArray<float4> _RecurrentWeightArr;
Texture2DArray<float4> _RecurrentMixedArr;
Texture2DArray<float4> _RecurrentConvCacheInArr;
RWTexture2DArray<float4> _RecurrentConvOutArr;
RWTexture2DArray<float4> _RecurrentConvCacheOutArr;
Texture2DArray<float4> _RecurrentQArr;
Texture2DArray<float4> _RecurrentKArr;
Texture2DArray<float4> _RecurrentVArr;
Texture2D<float4> _RecurrentAlogTex;
Texture2D<float4> _RecurrentDtBiasTex;
Texture2D<float4> _RecurrentBTex;
Texture2D<float4> _RecurrentATex;
Texture2DArray<float4> _RecurrentGdrStateInArr;
RWTexture2DArray<float4> _RecurrentGdrOutArr;
RWTexture2DArray<float4> _RecurrentGdrStateOutArr;
int _RecurrentGroups;
int _RecurrentKernel;
int _RecurrentSeq;
int _RecurrentCacheLength;
int _RecurrentHeads;
int _RecurrentKeyDim;
int _RecurrentValueDim;
int _RecurrentToken;
float _RecurrentEpsilon;

float RecurrentLoad2(Texture2DArray<float4> tex, int logicalWidth, int row, int index)
{
    float4 c = tex.Load(int4(index / 4, row, 0, 0));
    return c[index & 3];
}

float RecurrentLoad2Slice(Texture2DArray<float4> tex, int logicalWidth, int row, int slice, int index)
{
    float4 c = tex.Load(int4(index / 4, row, slice, 0));
    return c[index & 3];
}

float RecurrentLoadShortConvWeight(int group, int kernelIndex)
{
    // MemoryData exposes the kernel as logical [w=kernel, h=1, c=groups].
    // Pack4 storage therefore places groups in array slices, not texture rows.
    float4 packed = _RecurrentWeightArr.Load(int4(kernelIndex, 0, group / 4, 0));
    return packed[group & 3];
}

float RecurrentLoadLinearScalar(Texture2D<float4> tex, int row, int index)
{
    return tex.Load(int3(row * _RecurrentHeads + index, 0, 0)).x;
}

float RecurrentLoadGdrTensor(Texture2DArray<float4> tex, int token, int head, int index)
{
    float4 packedSequence = tex.Load(int4(index, head, token / 4, 0));
    return packedSequence[token & 3];
}

float RecurrentReadLane(float4 value, int lane)
{
    if (lane <= 0) return value.x;
    if (lane == 1) return value.y;
    if (lane == 2) return value.z;
    return value.w;
}

float4 RecurrentWriteLane(float4 value, int lane, float scalar)
{
    if (lane <= 0) value.x = scalar;
    else if (lane == 1) value.y = scalar;
    else if (lane == 2) value.z = scalar;
    else value.w = scalar;
    return value;
}

[numthreads(8, 8, 1)]
void AexisShortConvPack4(uint3 id : SV_DispatchThreadID)
{
    int groupBase = (int)id.x * 4;
    int token = (int)id.y;
    if (groupBase >= _RecurrentGroups)
        return;

    // Rebuild the fixed-size causal cache from the tail of
    // [cacheIn, mixed]. This preserves old rows during one-token decode.
    if (token < _RecurrentCacheLength)
    {
        int sourceIndex = _RecurrentSeq + token;
        float4 cacheValue = 0.0;
        for (int lane = 0; lane < 4; ++lane)
        {
            int group = groupBase + lane;
            if (group >= _RecurrentGroups)
                continue;
            float cached = sourceIndex < _RecurrentCacheLength
                ? RecurrentLoad2(_RecurrentConvCacheInArr, _RecurrentGroups, sourceIndex, group)
                : RecurrentLoad2(_RecurrentMixedArr, _RecurrentGroups, sourceIndex - _RecurrentCacheLength, group);
            if (lane == 0) cacheValue.x = cached;
            else if (lane == 1) cacheValue.y = cached;
            else if (lane == 2) cacheValue.z = cached;
            else cacheValue.w = cached;
        }
        _RecurrentConvCacheOutArr[int3(id.x, token, 0)] = cacheValue;
    }

    if (token >= _RecurrentSeq)
        return;
    float4 outValue = _RecurrentConvOutArr[int3(id.x, token, 0)];
    for (int lane = 0; lane < 4; ++lane)
    {
        int group = groupBase + lane;
        if (group >= _RecurrentGroups)
            continue;
        float sum = 0.0;
        for (int k = 0; k < _RecurrentKernel; ++k)
        {
            int historyIndex = _RecurrentCacheLength - _RecurrentKernel + token + 1 + k;
            float x = historyIndex < 0
                ? 0.0
                : (historyIndex < _RecurrentCacheLength
                    ? RecurrentLoad2(_RecurrentConvCacheInArr, _RecurrentGroups, historyIndex, group)
                    : RecurrentLoad2(_RecurrentMixedArr, _RecurrentGroups, historyIndex - _RecurrentCacheLength, group));
            sum += x * RecurrentLoadShortConvWeight(group, k);
        }
        float silu = sum / (1.0 + exp(-sum));
        if (lane == 0) outValue.x = silu;
        else if (lane == 1) outValue.y = silu;
        else if (lane == 2) outValue.z = silu;
        else outValue.w = silu;
    }
    _RecurrentConvOutArr[int3(id.x, token, 0)] = outValue;
}

[numthreads(8, 8, 1)]
void AexisGatedDeltaRulePack4(uint3 id : SV_DispatchThreadID)
{
    int head = (int)id.y;
    int valueBase = (int)id.x * 4;
    int token = _RecurrentToken;
    if (head >= _RecurrentHeads || token >= _RecurrentSeq || valueBase >= _RecurrentValueDim)
        return;

    float qNorm2 = 0.0;
    float kNorm2 = 0.0;
    for (int j = 0; j < _RecurrentKeyDim; ++j)
    {
        float qj = RecurrentLoadGdrTensor(_RecurrentQArr, token, head, j);
        float kj = RecurrentLoadGdrTensor(_RecurrentKArr, token, head, j);
        qNorm2 += qj * qj;
        kNorm2 += kj * kj;
    }
    float qScale = rsqrt(qNorm2 + _RecurrentEpsilon);
    float kScale = rsqrt(kNorm2 + _RecurrentEpsilon);
    float b = RecurrentLoadLinearScalar(_RecurrentBTex, token, head);
    float a = RecurrentLoadLinearScalar(_RecurrentATex, token, head);
    float alog = RecurrentLoadLinearScalar(_RecurrentAlogTex, 0, head);
    float dt = RecurrentLoadLinearScalar(_RecurrentDtBiasTex, 0, head);
    float beta = 1.0 / (1.0 + exp(-b));
    float decay = exp(-exp(alog) * (max(a + dt, 0.0) + log(1.0 + exp(-abs(a + dt)))));

    float4 memory = 0.0;
    for (int j = 0; j < _RecurrentKeyDim; ++j)
    {
        float kj = RecurrentLoadGdrTensor(_RecurrentKArr, token, head, j) * kScale;
        float4 decayedState = _RecurrentGdrStateInArr.Load(int4(id.x, j, head, 0)) * decay;
        memory += kj * decayedState;
    }

    float4 value = 0.0;
    for (int lane = 0; lane < 4; ++lane)
    {
        int valueIndex = valueBase + lane;
        if (valueIndex < _RecurrentValueDim)
            value = RecurrentWriteLane(value, lane, RecurrentLoadGdrTensor(_RecurrentVArr, token, head, valueIndex));
    }
    float4 delta = (value - memory) * beta;
    float4 projected = 0.0;
    for (int j = 0; j < _RecurrentKeyDim; ++j)
    {
        float kj = RecurrentLoadGdrTensor(_RecurrentKArr, token, head, j) * kScale;
        float qj = RecurrentLoadGdrTensor(_RecurrentQArr, token, head, j) * qScale;
        float4 updatedState = _RecurrentGdrStateInArr.Load(int4(id.x, j, head, 0)) * decay + kj * delta;
        _RecurrentGdrStateOutArr[int3(id.x, j, head)] = updatedState;
        projected += qj * updatedState;
    }
    projected *= rsqrt((float)_RecurrentKeyDim);

    int sequencePack = token / 4;
    int sequenceLane = token & 3;
    for (int outputLane = 0; outputLane < 4; ++outputLane)
    {
        int valueIndex = valueBase + outputLane;
        if (valueIndex >= _RecurrentValueDim)
            continue;
        float4 packedSequence = _RecurrentGdrOutArr[int3(valueIndex, head, sequencePack)];
        packedSequence = RecurrentWriteLane(packedSequence, sequenceLane, RecurrentReadLane(projected, outputLane));
        _RecurrentGdrOutArr[int3(valueIndex, head, sequencePack)] = packedSequence;
    }
}


