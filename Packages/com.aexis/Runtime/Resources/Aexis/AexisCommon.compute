float AexisResolveSdpaMask(int head, int row, int col)
{
    if (_SdpaMaskDims <= 0)
        return 0.0;

    if (_SdpaMaskDims == 1)
    {
        if (col < 0 || col >= _SdpaMaskW)
            return 0.0;
        return _SdpaMask[col];
    }

    if (_SdpaMaskDims == 2)
    {
        if (row < 0 || row >= _SdpaMaskH || col < 0 || col >= _SdpaMaskW)
            return 0.0;
        return _SdpaMask[row * _SdpaMaskW + col];
    }

    int channel = _SdpaMaskC > 1 ? clamp(head, 0, _SdpaMaskC - 1) : 0;
    if (row < 0 || row >= _SdpaMaskH || col < 0 || col >= _SdpaMaskW)
        return 0.0;
    int channelBase = channel * _SdpaMaskW * _SdpaMaskH;
    return _SdpaMask[channelBase + row * _SdpaMaskW + col];
}

