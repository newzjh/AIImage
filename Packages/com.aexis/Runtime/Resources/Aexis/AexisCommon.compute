// Common texture-native shape/index kernels formerly owned by the ONNX adapter.
#pragma kernel AexisNonZeroLinear
#pragma kernel AexisCompressLinear
#pragma kernel AexisGatherNDLinear
#pragma kernel AexisScatterLinear
#pragma kernel AexisTopKLinear
#pragma kernel AexisOneHotLinear

// D3 shape/index kernels intentionally use textures only. _ShapeOut[0] stores
// logical length, _ShapeOut[1] stores overflow (0/1); neither value is read back
// by the execution plan.
Texture2D<float> _Values;
Texture2D<int> _Indices;
Texture2D<int> _Parameter;
Texture2D<float> _Updates;
RWTexture2D<float> _Output;
RWTexture2D<int> _IndexOutput;
RWTexture2D<int> _ShapeOut;
int _InputLength;
int _Capacity;
int _KOrDepth;
int _Largest;
float _OffValue;
float _OnValue;

int ReadIndex(int index) { return _Indices[int2(index, 0)]; }
int ReadParameter(int index) { return _Parameter[int2(index, 0)]; }
float ReadValue(int index) { return _Values[int2(index, 0)]; }
float ReadUpdate(int index) { return _Updates[int2(index, 0)]; }

[numthreads(1, 1, 1)]
void AexisNonZeroLinear(uint3 id : SV_DispatchThreadID)
{
    int count = 0;
    [loop] for (int i = 0; i < _InputLength; ++i)
        if (ReadValue(i) != 0.0) { if (count < _Capacity) _IndexOutput[int2(count, 0)] = i; ++count; }
    _ShapeOut[int2(0, 0)] = min(count, _Capacity);
    _ShapeOut[int2(1, 0)] = count > _Capacity ? 1 : 0;
}

[numthreads(1, 1, 1)]
void AexisCompressLinear(uint3 id : SV_DispatchThreadID)
{
    int count = 0;
    [loop] for (int i = 0; i < _InputLength; ++i)
        if (ReadIndex(i) != 0) { if (count < _Capacity) _Output[int2(count, 0)] = ReadValue(i); ++count; }
    _ShapeOut[int2(0, 0)] = min(count, _Capacity);
    _ShapeOut[int2(1, 0)] = count > _Capacity ? 1 : 0;
}

[numthreads(64, 1, 1)]
void AexisGatherNDLinear(uint3 id : SV_DispatchThreadID)
{
    int i = id.x;
    if (i >= _Capacity) return;
    int source = ReadIndex(i);
    _Output[int2(i, 0)] = source >= 0 && source < _InputLength ? ReadValue(source) : 0.0;
}

[numthreads(1, 1, 1)]
void AexisScatterLinear(uint3 id : SV_DispatchThreadID)
{
    [loop] for (int i = 0; i < _InputLength; ++i) _Output[int2(i, 0)] = ReadValue(i);
    // Planner accepts only statically/provably unique destinations. Serial writes
    // make that public reject-on-conflict contract deterministic on every backend.
    [loop] for (int i = 0; i < _Capacity; ++i) { int dst = ReadIndex(i); if (dst >= 0 && dst < _InputLength) _Output[int2(dst, 0)] = ReadUpdate(i); }
}

[numthreads(1, 1, 1)]
void AexisTopKLinear(uint3 id : SV_DispatchThreadID)
{
    int requestedK = ReadParameter(0);
    int k = min(max(0, requestedK), min(_InputLength, _Capacity));
    [loop] for (int rank = 0; rank < k; ++rank) {
        int chosen = -1; float chosenValue = 0.0;
        [loop] for (int candidate = 0; candidate < _InputLength; ++candidate) {
            float value = ReadValue(candidate); int ahead = 0;
            [loop] for (int other = 0; other < _InputLength; ++other) { float otherValue = ReadValue(other); bool better = _Largest != 0 ? (otherValue > value || (otherValue == value && other < candidate)) : (otherValue < value || (otherValue == value && other < candidate)); if (better) ++ahead; }
            if (ahead == rank) { chosen = candidate; chosenValue = value; break; }
        }
        _Output[int2(rank, 0)] = chosenValue; _IndexOutput[int2(rank, 0)] = chosen;
    }
    _ShapeOut[int2(0, 0)] = k; _ShapeOut[int2(1, 0)] = requestedK > _Capacity ? 1 : 0;
}

[numthreads(64, 1, 1)]
void AexisOneHotLinear(uint3 id : SV_DispatchThreadID)
{
    int outputIndex = id.x; int requestedDepth = ReadParameter(0); int depth = min(max(0, requestedDepth), _Capacity); int total = _InputLength * depth;
    if (outputIndex >= total) return;
    int row = outputIndex / depth; int column = outputIndex - row * depth; int index = ReadIndex(row); if (index < 0) index += depth;
    _Output[int2(outputIndex, 0)] = index == column ? _OnValue : _OffValue;
    if (outputIndex == 0) { _ShapeOut[int2(0, 0)] = depth; _ShapeOut[int2(1, 0)] = requestedDepth > _Capacity ? 1 : 0; }
}
