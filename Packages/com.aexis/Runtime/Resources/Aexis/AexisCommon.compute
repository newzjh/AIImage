float4 AexisErfApprox4(float4 x)
{
    float4 a1 = 0.254829592;
    float4 a2 = -0.284496736;
    float4 a3 = 1.421413741;
    float4 a4 = -1.453152027;
    float4 a5 = 1.061405429;
    float4 p = 0.3275911;
    float4 s = sign(x);
    float4 xAbs = abs(x);
    float4 t = 1.0 / (1.0 + p * xAbs);
    float4 y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp(-xAbs * xAbs);
    return s * y;
}

float4 AexisApplyPointwise4(float4 x)
{
    int t = _PointwiseType;
    if (t == 0) return x < 0.0 ? _PointwiseA * (exp(x) - 1.0) : x;
    if (t == 1) return AexisErfApprox4(x);
    if (t == 2)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        return x < lower ? 0.0 : x > upper ? 1.0 : x * alpha + beta;
    }
    if (t == 3)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        return x < lower ? 0.0 : x > upper ? x : x * (x * alpha + beta);
    }
    if (t == 4)
    {
        float4 y = x > 20.0 ? x : x < -20.0 ? exp(x) : log(exp(x) + 1.0);
        return x * tanh(y);
    }
    if (t == 5)
    {
        float alpha = _PointwiseA;
        float lambda = _PointwiseB;
        return x < 0.0 ? (exp(x) - 1.0) * alpha * lambda : x * lambda;
    }
    if (t == 6)
    {
        float bias = _PointwiseA;
        float lambd = _PointwiseB;
        return x < -lambd ? x + bias : x > lambd ? x - bias : 0.0;
    }
    if (t == 7) return max(x, 0.0) + log(1.0 + exp(-abs(x)));
    if (t == 8)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 1.0 : _PointwiseA;
        return x < 0.0 ? (exp(x / alpha) - 1.0) * alpha : x;
    }
    if (t == 9) return x * _PointwiseA;
    if (t == 10) return pow(_PointwiseC + x * _PointwiseB, _PointwiseA);
    if (t == 11) return x > _PointwiseA ? 1.0 : 0.0;
    if (t == 12) return x / (1.0 + abs(x));
    if (t == 13) return float4(
        isinf(x.x) && ((x.x < 0.0 && _PointwiseA != 0.0) || (x.x > 0.0 && _PointwiseB != 0.0)) ? 1.0 : 0.0,
        isinf(x.y) && ((x.y < 0.0 && _PointwiseA != 0.0) || (x.y > 0.0 && _PointwiseB != 0.0)) ? 1.0 : 0.0,
        isinf(x.z) && ((x.z < 0.0 && _PointwiseA != 0.0) || (x.z > 0.0 && _PointwiseB != 0.0)) ? 1.0 : 0.0,
        isinf(x.w) && ((x.w < 0.0 && _PointwiseA != 0.0) || (x.w > 0.0 && _PointwiseB != 0.0)) ? 1.0 : 0.0);
    if (t == 14) return float4(isnan(x.x) ? 1.0 : 0.0, isnan(x.y) ? 1.0 : 0.0, isnan(x.z) ? 1.0 : 0.0, isnan(x.w) ? 1.0 : 0.0);
    if (t == 15)
    {
        float4 exponent = _PointwiseC + x * _PointwiseB;
        return _PointwiseA == -1.0 ? exp(exponent) : pow(_PointwiseA, exponent);
    }
    if (t == 16)
    {
        float4 value = log(_PointwiseC + x * _PointwiseB);
        return _PointwiseA == -1.0 ? value : value / log(_PointwiseA);
    }
    if (t == 17) return x > _PointwiseA ? x : 0.0;
    return x;
}

int AexisQuantAxisIndex(int idx)
{
    if (_QuantDims <= 1)
        return idx;
    if (_QuantDims == 2)
        return idx / max(1, _QuantW);
    int plane = max(1, _QuantW * _QuantH * _QuantD);
    return idx / plane;
}

float AexisResolveQuantScaleIn(int axis)
{
    if (_QuantScaleInSize <= 0)
        return 1.0;
    if (_QuantScaleInSize == 1)
        return _QuantScale[0];
    return _QuantScale[clamp(axis, 0, _QuantScaleInSize - 1)];
}

float AexisResolveQuantScaleOut(int axis)
{
    if (_QuantScaleOutSize <= 0)
        return 1.0;
    if (_QuantScaleOutSize == 1)
        return _QuantScaleOut[0];
    return _QuantScaleOut[clamp(axis, 0, _QuantScaleOutSize - 1)];
}

float AexisResolveQuantBias(int axis)
{
    if (_QuantBiasSize <= 0)
        return 0.0;
    if (_QuantBiasSize == 1)
        return _QuantBias[0];
    return _QuantBias[clamp(axis, 0, _QuantBiasSize - 1)];
}

float AexisApplyActivationScalarQuant(float v)
{
    if (_QuantActType == 1)
        return max(v, 0.0);
    if (_QuantActType == 2)
        return v < 0.0 ? v * _QuantActParam0 : v;
    if (_QuantActType == 3)
        return clamp(v, _QuantActParam0, _QuantActParam1);
    if (_QuantActType == 4)
        return 1.0 / (1.0 + exp(-v));
    if (_QuantActType == 5)
        return v * tanh(log(exp(v) + 1.0));
    if (_QuantActType == 6)
        return v * clamp(v * _QuantActParam0 + _QuantActParam1, 0.0, 1.0);
    return v;
}

float AexisCastScalar(float value)
{
    if (_CastTypeFrom == _CastTypeTo)
        return value;

    if (_CastTypeTo == 2)
    {
        return f16tof32(f32tof16(value));
    }

    if (_CastTypeTo == 4)
    {
        uint bits = asuint(value);
        uint lsb = (bits >> 16) & 1;
        bits += 0x7FFFu + lsb;
        bits &= 0xFFFF0000u;
        return asfloat(bits);
    }

    if (_CastTypeTo == 3)
    {
        return clamp((float)(int)value, -128.0, 127.0);
    }

    if (_CastTypeTo == 7)
    {
        return value != 0.0 ? 1.0 : 0.0;
    }

    // Int32/UInt8 tensors stay physically float-backed in the Pack4 texture.
    // The cast is still applied numerically so index/shape consumers observe
    // ONNX truncation semantics without a buffer materialization.
    if (_CastTypeTo == 5)
    {
        return (float)(int)value;
    }

    if (_CastTypeTo == 6)
    {
        return clamp((float)(int)value, 0.0, 255.0);
    }

    return value;
}

int AexisBufferAxisIndex(int dims, int w, int h, int d, int c, int idx)
{
    if (dims <= 1)
        return idx;
    if (dims == 2)
        return idx / max(1, w);
    int plane = max(1, w * h * d);
    return idx / plane;
}

float AexisResolveScaleValue(int axis)
{
    if (_ScaleDataSize <= 0)
        return 1.0;
    if (_ScaleDataSize == 1)
        return _ScaleScaleBuf[0];
    return _ScaleScaleBuf[clamp(axis, 0, _ScaleDataSize - 1)];
}

float AexisResolveScaleBias(int axis)
{
    if (_ScaleBiasTerm == 0)
        return 0.0;
    if (_ScaleDataSize <= 0)
        return 0.0;
    if (_ScaleDataSize == 1)
        return _ScaleBiasBuf[0];
    return _ScaleBiasBuf[clamp(axis, 0, _ScaleDataSize - 1)];
}

float AexisResolvePReluSlope(int axis)
{
    if (_PReluSlopeCount <= 0)
        return 0.0;
    if (_PReluSlopeCount == 1)
        return _PReluSlopeBuf[0];
    return _PReluSlopeBuf[clamp(axis, 0, _PReluSlopeCount - 1)];
}

