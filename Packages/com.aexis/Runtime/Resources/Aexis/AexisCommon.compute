float AexisGnReadPack4(uint c, uint s)
{
    uint wh = (uint)(_GnW * _GnH);
    uint z = s / wh;
    uint rem = s - z * wh;
    uint y = rem / (uint)_GnW;
    uint x = rem - y * (uint)_GnW;
    int packCount = max(1, (_GnC + 3) / 4);
    int pack = (int)(c >> 2);
    int lane = (int)(c & 3u);
    int slice = (int)z * packCount + pack;
    float4 v = _GnTexInArr[int3((int)x, (int)y, slice)];
    return lane == 0 ? v.x : (lane == 1 ? v.y : (lane == 2 ? v.z : v.w));
}

