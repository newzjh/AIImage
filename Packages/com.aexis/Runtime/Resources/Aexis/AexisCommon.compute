float AexisErfApproxScalar(float x)
{
    float a1 = 0.254829592;
    float a2 = -0.284496736;
    float a3 = 1.421413741;
    float a4 = -1.453152027;
    float a5 = 1.061405429;
    float p = 0.3275911;
    float s = sign(x);
    float xAbs = abs(x);
    float t = 1.0 / (1.0 + p * xAbs);
    float y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * exp(-xAbs * xAbs);
    return s * y;
}

float AexisApplyPointwiseScalar(float x)
{
    int t = _PointwiseType;
    if (t == 0) return x < 0.0 ? _PointwiseA * (exp(x) - 1.0) : x; // ELU
    if (t == 1) return AexisErfApproxScalar(x); // Erf
    if (t == 2)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        if (x < lower) return 0.0;
        if (x > upper) return 1.0;
        return x * alpha + beta;
    }
    if (t == 3)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 0.2 : _PointwiseA;
        float beta = _PointwiseB;
        float lower = -beta / alpha;
        float upper = (1.0 / alpha) + lower;
        if (x < lower) return 0.0;
        if (x > upper) return x;
        return x * (x * alpha + beta);
    }
    if (t == 4)
    {
        float y = x > 20.0 ? x : x < -20.0 ? exp(x) : log(exp(x) + 1.0);
        return x * tanh(y);
    }
    if (t == 5)
    {
        float alpha = _PointwiseA;
        float lambda = _PointwiseB;
        return x < 0.0 ? (exp(x) - 1.0) * alpha * lambda : x * lambda;
    }
    if (t == 6)
    {
        float bias = _PointwiseA;
        float lambd = _PointwiseB;
        return x < -lambd ? x + bias : x > lambd ? x - bias : 0.0;
    }
    if (t == 7) return max(x, 0.0) + log(1.0 + exp(-abs(x))); // Softplus / BNLL
    if (t == 8)
    {
        float alpha = abs(_PointwiseA) < 1e-12 ? 1.0 : _PointwiseA;
        return x < 0.0 ? (exp(x / alpha) - 1.0) * alpha : x;
    }
    if (t == 9) return x * _PointwiseA; // Dropout(scale)
    if (t == 10) return pow(_PointwiseC + x * _PointwiseB, _PointwiseA); // Power(power, scale, shift)
    if (t == 11) return x > _PointwiseA ? 1.0 : 0.0; // Threshold
    if (t == 12) return x / (1.0 + abs(x)); // Softsign
    if (t == 13) return isinf(x) && ((x < 0.0 && _PointwiseA != 0.0) || (x > 0.0 && _PointwiseB != 0.0)) ? 1.0 : 0.0;
    if (t == 14) return isnan(x) ? 1.0 : 0.0;
    if (t == 15)
    {
        float exponent = _PointwiseC + x * _PointwiseB;
        return _PointwiseA == -1.0 ? exp(exponent) : pow(_PointwiseA, exponent);
    }
    if (t == 16)
    {
        float value = log(_PointwiseC + x * _PointwiseB);
        return _PointwiseA == -1.0 ? value : value / log(_PointwiseA);
    }
    if (t == 17) return x > _PointwiseA ? x : 0.0; // ONNX ThresholdedRelu
    return x;
}

float AexisApplyBinaryOpScalar(float a, float b, int t)
{
    if (t == 0) return a + b;
    if (t == 1) return a - b;
    if (t == 2) return a * b;
    if (t == 3) return a / b;
    if (t == 4) return max(a, b);
    if (t == 5) return min(a, b);
    if (t == 6) return pow(a, b);
    if (t == 7) return b - a;
    if (t == 8) return b / a;
    if (t == 9) return pow(b, a);
    if (t == 10) return atan2(a, b);
    if (t == 11) return atan2(b, a);
    if (t == 12) return fmod(a, b);
    if (t == 13) return fmod(b, a);
    if (t == 14)
    {
        float maximum = max(a, b);
        float minimum = min(a, b);
        return maximum + log(1.0 + exp(minimum - maximum));
    }
    if (t == 15) return floor(a / b);
    if (t == 16) return floor(b / a);
    if (t == 17) return a - round(a / b) * b;
    if (t == 18) return b - round(b / a) * a;
    if (t == 19) return a - floor(a / b) * b; // ONNX Mod(fmod=0)
    if (t == 20) return a == b ? 1.0 : 0.0;
    if (t == 21) return a > b ? 1.0 : 0.0;
    if (t == 22) return a >= b ? 1.0 : 0.0;
    if (t == 23) return a < b ? 1.0 : 0.0;
    if (t == 24) return a <= b ? 1.0 : 0.0;
    if (t == 25) return a != 0.0 && b != 0.0 ? 1.0 : 0.0;
    if (t == 26) return a != 0.0 || b != 0.0 ? 1.0 : 0.0;
    if (t == 27) return (a != 0.0) != (b != 0.0) ? 1.0 : 0.0;
    return a;
}

float4 AexisApplyBinaryOp4(float4 a, float4 b, int t)
{
    return float4(
        AexisApplyBinaryOpScalar(a.x, b.x, t),
        AexisApplyBinaryOpScalar(a.y, b.y, t),
        AexisApplyBinaryOpScalar(a.z, b.z, t),
        AexisApplyBinaryOpScalar(a.w, b.w, t));
}

