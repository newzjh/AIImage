Texture2D<float4> _Source;
Texture2D<float4> _AnalysisIn;
Texture2D<float> _MaskIn;
Texture2D<float4> _BaseIn;
Texture2D<float> _EnhancedDetailIn;
Texture2D<float> _SharpenYIn;
Texture2D<float> _DirectionalResponseIn;
Texture2D<float> _FaceMaskIn;
Texture2D<float4> _DebugIn;
Texture2D<float> _ScalarIn;
Texture2D<float> _GuidedIn;
Texture2D<float> _MidIn;
Texture2D<float> _NoiseFilteredIn;
Texture2D<float> _FaceStructIn;
Texture2D<float> _LowIn;
Texture2D<float> _HighIn;
Texture2D<float> _LowUpIn;
Texture2D<float> _LapIn;
Texture2D<float> _AccIn;
Texture2D<float> _AddIn;
Texture2D<float> _DebugScalarIn;
Texture2D<float> _AIn;
Texture2D<float> _BIn;
Texture2D<float> _MeanIIn;
Texture2D<float> _MeanIIIn;
Texture2D<float> _MeanAIn;
Texture2D<float> _MeanBIn;
Texture2D<float> _BlurIn;
Texture2D<float> _NoiseIn;

RWTexture2D<float4> _AnalysisOut;
RWTexture2D<float> _MaskOut;
RWTexture2D<float4> _BaseOut;
RWTexture2D<float> _DetailOut;
RWTexture2D<float> _SharpenYOut;
RWTexture2D<float4> _Result;
RWTexture2D<float> _DirectionalResponseOut;
RWTexture2D<float> _ScalarOut;
RWTexture2D<float> _UpOut;
RWTexture2D<float> _LapOut;
RWTexture2D<float> _EnhancedOut;
RWTexture2D<float> _AccOut;
RWTexture2D<float> _SharpenLapOut;
RWTexture2D<float> _FaceMaskOut;
RWTexture2D<float> _BoxOut;
RWTexture2D<float> _SquareOut;
RWTexture2D<float> _AOut;
RWTexture2D<float> _BOut;
RWTexture2D<float> _GuidedOut;
RWTexture2D<float> _MidOut;
RWTexture2D<float> _NoiseOut;
RWTexture2D<float> _FaceStructOut;
RWTexture2D<float> _FaceEnhancedOut;


int _Radius;
float _SigmaSpatial;
float _SigmaRange;
float _DirStrength;
float _DebugScale;
float _LapWeight;
float _LapDirStrength;
float _Wb;
float _Alpha;
float _Beta;
float _ClampDelta;
int _BoxRadius;
float _GuidedEps;
float _MidW;
float _TextureScale;
float _BilateralSigmaRange;

static const float3 kLuma = float3(0.2126, 0.7152, 0.0722);

float3 Clamp01(float3 v) { return saturate(v); }

float Luma(float3 rgb) { return dot(rgb, kLuma); }

float4 SampleClamped(Texture2D<float4> tex, int2 p, int2 size)
{
    int2 q = clamp(p, int2(0, 0), size - 1);
    return tex[q];
}

float2 Normalize2(float2 v)
{
    float l2 = dot(v, v);
    if (l2 < 1e-10) return float2(0, 0);
    return v * rsqrt(l2);
}



float3 YCbCrFromRgb(float3 rgb)
{
    float R = rgb.r;
    float G = rgb.g;
    float B = rgb.b;
    float Y = dot(rgb, float3(0.299, 0.587, 0.114));
    float Cb = 128.0 / 255.0 + (-0.168736 * R - 0.331264 * G + 0.5 * B);
    float Cr = 128.0 / 255.0 + (0.5 * R - 0.418688 * G - 0.081312 * B);
    return float3(Y, Cb, Cr);
}

float3 RgbFromYCbCr(float3 ycc)
{
    float Y = ycc.x;
    float Cb = ycc.y - 128.0 / 255.0;
    float Cr = ycc.z - 128.0 / 255.0;
    float R = Y + 1.402 * Cr;
    float G = Y - 0.344136 * Cb - 0.714136 * Cr;
    float B = Y + 1.772 * Cb;
    return float3(R, G, B);
}

[numthreads(8,8,1)]
void StructureAnalysis(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _AnalysisOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 size = int2((int)w, (int)h);
    int2 p = int2(id.xy);

    float y00 = Luma(SampleClamped(_Source, p + int2(-1, -1), size).rgb);
    float y10 = Luma(SampleClamped(_Source, p + int2( 0, -1), size).rgb);
    float y20 = Luma(SampleClamped(_Source, p + int2( 1, -1), size).rgb);
    float y01 = Luma(SampleClamped(_Source, p + int2(-1,  0), size).rgb);
    float y11 = Luma(SampleClamped(_Source, p + int2( 0,  0), size).rgb);
    float y21 = Luma(SampleClamped(_Source, p + int2( 1,  0), size).rgb);
    float y02 = Luma(SampleClamped(_Source, p + int2(-1,  1), size).rgb);
    float y12 = Luma(SampleClamped(_Source, p + int2( 0,  1), size).rgb);
    float y22 = Luma(SampleClamped(_Source, p + int2( 1,  1), size).rgb);

    float gx = (-3.0*y00 + 3.0*y20) + (-10.0*y01 + 10.0*y21) + (-3.0*y02 + 3.0*y22);
    float gy = (-3.0*y00 - 10.0*y10 - 3.0*y20) + (3.0*y02 + 10.0*y12 + 3.0*y22);

    float2 g = float2(gx, gy);
    float edge = sqrt(dot(g, g)) * (1.0 / 16.0);
    edge = saturate(edge);

    float2 dir = Normalize2(g);

    float m = (y00 + y10 + y20 + y01 + y11 + y21 + y02 + y12 + y22) / 9.0;
    float msq =
        (y00*y00 + y10*y10 + y20*y20 +
         y01*y01 + y11*y11 + y21*y21 +
         y02*y02 + y12*y12 + y22*y22) / 9.0;
    float var = max(0.0, msq - m*m);
    float tex = saturate(var * 18.0);

    float flat = saturate(1.0 - (edge * 1.4 + tex * 0.9));

    _AnalysisOut[p] = float4(edge, dir.x, dir.y, tex);
    _MaskOut[p] = flat;
}

[numthreads(8,8,1)]
void EdgeAwareDecompose(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _BaseOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 size = int2((int)w, (int)h);
    int2 p = int2(id.xy);

    float3 c0 = SampleClamped(_Source, p, size).rgb;
    float y0 = Luma(c0);
    float edge0 = _AnalysisIn[p].x;

    int r = max(1, _Radius);
    float sigmaS = max(0.6, _SigmaSpatial);
    float sigmaR = max(0.01, _SigmaRange);
    float inv2SigmaS2 = 0.5 / (sigmaS * sigmaS);
    float inv2SigmaR2 = 0.5 / (sigmaR * sigmaR);

    float3 sum = 0;
    float wsum = 0;

    for (int dy = -r; dy <= r; dy++)
    {
        for (int dx = -r; dx <= r; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), size - 1);
            float3 cq = _Source[q].rgb;
            float yq = Luma(cq);
            float ds2 = (float)(dx*dx + dy*dy);
            float dy2 = (yq - y0) * (yq - y0);
            float ws = exp(-ds2 * inv2SigmaS2);
            float wr = exp(-dy2 * inv2SigmaR2);
            float eq = _AnalysisIn[q].x;
            float we = exp(-(edge0 + eq) * 2.2);
            float ww = ws * wr * we;
            sum += cq * ww;
            wsum += ww;
        }
    }

    float3 baseRgb = sum / max(1e-6, wsum);
    float baseY = Luma(baseRgb);
    float detailY = y0 - baseY;

    _BaseOut[p] = float4(Clamp01(baseRgb), 1);
    _DetailOut[p] = detailY;
}

[numthreads(8,8,1)]
void GaussianDown2(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh;
    _ScalarOut.GetDimensions(ow, oh);
    if (id.x >= ow || id.y >= oh) return;

    uint iw, ih;
    _ScalarIn.GetDimensions(iw, ih);
    int2 isize = int2((int)iw, (int)ih);
    int2 op = int2(id.xy);

    float2 center = float2(op.x * 2 + 0.5, op.y * 2 + 0.5);
    int2 c = int2((int)floor(center.x), (int)floor(center.y));

    float sum = 0;
    float wsum = 0;
    int wx[3] = { 1, 2, 1 };
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            int2 q = clamp(c + int2(i, j), int2(0, 0), isize - 1);
            float w = (float)(wx[i + 1] * wx[j + 1]);
            sum += _ScalarIn[q] * w;
            wsum += w;
        }
    }

    _ScalarOut[op] = sum / max(1e-6, wsum);
}

[numthreads(8,8,1)]
void GaussianUp2(uint3 id : SV_DispatchThreadID)
{
    uint ow, oh;
    _UpOut.GetDimensions(ow, oh);
    if (id.x >= ow || id.y >= oh) return;

    uint iw, ih;
    _LowIn.GetDimensions(iw, ih);
    float2 srcSize = float2((float)iw, (float)ih);
    float2 dstSize = float2((float)ow, (float)oh);

    float2 uv = (float2(id.x, id.y) + 0.5) / dstSize;
    float2 src = uv * srcSize - 0.5;

    int2 p0 = int2(floor(src));
    float2 f = frac(src);

    int2 p00 = clamp(p0, int2(0,0), int2((int)iw - 1, (int)ih - 1));
    int2 p10 = clamp(p0 + int2(1,0), int2(0,0), int2((int)iw - 1, (int)ih - 1));
    int2 p01 = clamp(p0 + int2(0,1), int2(0,0), int2((int)iw - 1, (int)ih - 1));
    int2 p11 = clamp(p0 + int2(1,1), int2(0,0), int2((int)iw - 1, (int)ih - 1));

    float c00 = _LowIn[p00];
    float c10 = _LowIn[p10];
    float c01 = _LowIn[p01];
    float c11 = _LowIn[p11];

    float cx0 = lerp(c00, c10, f.x);
    float cx1 = lerp(c01, c11, f.x);
    float c = lerp(cx0, cx1, f.y);
    _UpOut[int2(id.xy)] = c;
}

[numthreads(8,8,1)]
void LaplacianDiff(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _LapOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    _LapOut[p] = _HighIn[p] - _LowUpIn[p];
}

[numthreads(8,8,1)]
void EnhanceLaplacian(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _EnhancedOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float lap = _LapIn[p];

    uint aw, ah;
    _AnalysisIn.GetDimensions(aw, ah);
    float2 uv = (float2(id.x, id.y) + 0.5) / float2(w, h);
    float2 aSrc = uv * float2((float)aw, (float)ah) - 0.5;
    int2 aP0 = int2(floor(aSrc));
    float2 af = frac(aSrc);

    int2 a00 = clamp(aP0, int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a10 = clamp(aP0 + int2(1,0), int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a01 = clamp(aP0 + int2(0,1), int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a11 = clamp(aP0 + int2(1,1), int2(0,0), int2((int)aw - 1, (int)ah - 1));

    float4 an00 = _AnalysisIn[a00];
    float4 an10 = _AnalysisIn[a10];
    float4 an01 = _AnalysisIn[a01];
    float4 an11 = _AnalysisIn[a11];
    float4 an0 = lerp(an00, an10, af.x);
    float4 an1 = lerp(an01, an11, af.x);
    float4 an = lerp(an0, an1, af.y);

    float edge = an.x;
    float tex = an.w;

    float sum = 0;
    float sumSq = 0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), int2((int)w - 1, (int)h - 1));
            float v = _LapIn[q];
            sum += v;
            sumSq += v * v;
        }
    }
    float mean = sum / 9.0;
    float var = max(0.0, (sumSq / 9.0) - mean * mean);

    float texGate = saturate((tex - 0.0015) * 80.0);
    float varGate = saturate(var * 160000.0);
    float lapGate = saturate((abs(lap) - 0.0005) * 3000.0);
    float edgeGate = 1.0 - saturate(edge * 0.9);
    float gate = texGate * max(varGate, lapGate) * (0.35 + 0.65 * edgeGate);

    float boost = 3.0;
    float scale = 1.0 + (_LapWeight * gate) * boost;
    scale = min(scale, 8.0);
    float enhanced = lap * scale;
    enhanced = clamp(enhanced, -0.50, 0.50);
    _EnhancedOut[p] = enhanced;
}

[numthreads(8,8,1)]
void DirectionalSharpenLap(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SharpenLapOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float v0 = _LapIn[p];

    uint aw, ah;
    _AnalysisIn.GetDimensions(aw, ah);
    float2 uv = (float2(id.x, id.y) + 0.5) / float2(w, h);
    float2 aSrc = uv * float2((float)aw, (float)ah) - 0.5;
    int2 aP0 = int2(floor(aSrc));
    float2 af = frac(aSrc);

    int2 a00 = clamp(aP0, int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a10 = clamp(aP0 + int2(1,0), int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a01 = clamp(aP0 + int2(0,1), int2(0,0), int2((int)aw - 1, (int)ah - 1));
    int2 a11 = clamp(aP0 + int2(1,1), int2(0,0), int2((int)aw - 1, (int)ah - 1));

    float4 an00 = _AnalysisIn[a00];
    float4 an10 = _AnalysisIn[a10];
    float4 an01 = _AnalysisIn[a01];
    float4 an11 = _AnalysisIn[a11];
    float4 an0 = lerp(an00, an10, af.x);
    float4 an1 = lerp(an01, an11, af.x);
    float4 an = lerp(an0, an1, af.y);

    float edge = an.x;
    float2 dir = Normalize2(an.yz);
    float tex = an.w;

    float2 t = Normalize2(float2(-dir.y, dir.x));
    int2 step = int2((int)round(t.x), (int)round(t.y));
    if (step.x == 0 && step.y == 0) step = int2(1, 0);

    int2 size = int2((int)w, (int)h);
    float vP = _LapIn[clamp(p + step, int2(0,0), size - 1)];
    float vM = _LapIn[clamp(p - step, int2(0,0), size - 1)];
    float avgT = 0.5 * (vP + vM);
    float dirComp = v0 - avgT;

    float texGate = saturate((tex - 0.004) * 40.0);
    float edgeGate = 1.0 - saturate(edge * 0.9);
    float gate = texGate * (0.25 + 0.75 * edgeGate);

    float outV = v0 + (_LapDirStrength * gate) * dirComp;
    outV = clamp(outV, -0.60, 0.60);
    _SharpenLapOut[p] = outV;
}

[numthreads(8,8,1)]
void AddScalar(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _AccOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    _AccOut[p] = _AccIn[p] + _AddIn[p];
}

[numthreads(8,8,1)]
void DirectionalResponse(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _DirectionalResponseOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float4 an = _AnalysisIn[p];
    float2 dir = Normalize2(an.yz);

    float2 t = Normalize2(float2(-dir.y, dir.x));
    int2 step = int2((int)round(t.x), (int)round(t.y));
    if (step.x == 0 && step.y == 0) step = int2(1, 0);

    int2 size = int2((int)w, (int)h);
    int2 o1 = step;
    int2 o2 = step * 2;

    float s_m2 = _EnhancedDetailIn[clamp(p - o2, int2(0,0), size - 1)];
    float s_m1 = _EnhancedDetailIn[clamp(p - o1, int2(0,0), size - 1)];
    float s_0  = _EnhancedDetailIn[p];
    float s_p1 = _EnhancedDetailIn[clamp(p + o1, int2(0,0), size - 1)];
    float s_p2 = _EnhancedDetailIn[clamp(p + o2, int2(0,0), size - 1)];

    float r = (-0.1 * s_m2) + (-0.2 * s_m1) + (1.8 * s_0) + (-0.2 * s_p1) + (-0.1 * s_p2);
    r = clamp(r, -0.90, 0.90);
    _DirectionalResponseOut[p] = r;
}

[numthreads(8,8,1)]
void ApplyDirectionalSharpen(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SharpenYOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float4 an = _AnalysisIn[p];
    float E = max(0.02, saturate(an.x));
    float V = max(0.05, an.w);

    float wb = max(0.0, _Wb);
    float alpha = max(0.0, _Alpha);
    float beta = max(0.0, _Beta);
    float w0 = wb * pow(max(E, 1e-6), alpha) * pow(V, beta);
    w0 = clamp(w0, 0.0, 20.0);

    float baseY = Luma(_BaseIn[p].rgb);
    float r = _DirectionalResponseIn[p];
    float y = baseY + (w0 * r * 4.0);
    y = saturate(y);
    _SharpenYOut[p] = y;
}

[numthreads(8,8,1)]
void EdgeAwareClamp(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SharpenYOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    int2 size = int2((int)w, (int)h);

    float ySharpen = _SharpenYIn[p];

    float yMin = 1.0;
    float yMax = 0.0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), size - 1);
            float y = Luma(_Source[q].rgb);
            yMin = min(yMin, y);
            yMax = max(yMax, y);
        }
    }

    float range = max(1e-6, yMax - yMin);
    float delta = saturate(_ClampDelta);

    float E = saturate(_AnalysisIn[p].x);
    float edgeTighten = lerp(1.0, 0.25, saturate(E * 1.2));
    delta *= edgeTighten;

    float lo = yMin - delta * range;
    float hi = yMax + delta * range;
    float yClamped = clamp(ySharpen, lo, hi);

    _SharpenYOut[p] = yClamped;
}

[numthreads(8,8,1)]
void NoiseSuppression(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SharpenYOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 size = int2((int)w, (int)h);
    int2 p = int2(id.xy);

    float yOrig = Luma(_Source[p].rgb);
    float ySharp = _SharpenYIn[p];

    float y00 = Luma(SampleClamped(_Source, p + int2(-1, -1), size).rgb);
    float y10 = Luma(SampleClamped(_Source, p + int2( 0, -1), size).rgb);
    float y20 = Luma(SampleClamped(_Source, p + int2( 1, -1), size).rgb);
    float y01 = Luma(SampleClamped(_Source, p + int2(-1,  0), size).rgb);
    float y11 = yOrig;
    float y21 = Luma(SampleClamped(_Source, p + int2( 1,  0), size).rgb);
    float y02 = Luma(SampleClamped(_Source, p + int2(-1,  1), size).rgb);
    float y12 = Luma(SampleClamped(_Source, p + int2( 0,  1), size).rgb);
    float y22 = Luma(SampleClamped(_Source, p + int2( 1,  1), size).rgb);

    float gx = (-3.0*y00 + 3.0*y20) + (-10.0*y01 + 10.0*y21) + (-3.0*y02 + 3.0*y22);
    float gy = (-3.0*y00 - 10.0*y10 - 3.0*y20) + (3.0*y02 + 10.0*y12 + 3.0*y22);

    float Jxx = gx * gx;
    float Jyy = gy * gy;
    float Jxy = gx * gy;

    float trace = Jxx + Jyy;
    float det = Jxx * Jyy - Jxy * Jxy;
    float disc = max(0.0, trace * trace - 4.0 * det);
    float sqrtDisc = sqrt(disc);

    float coherence = sqrtDisc / max(1e-6, trace);
    coherence = saturate(coherence);

    float V = saturate(_AnalysisIn[p].w);
    float vGate = saturate((V - 0.02) * 20.0);
    float cGate = saturate((coherence - 0.10) / 0.90);

    float keep = saturate(cGate * (0.35 + 0.65 * vGate));
    float fm = saturate(_FaceMaskIn[p]);
    keep = lerp(keep, 1.0, fm);
    float yOut = lerp(yOrig, ySharp, keep);

    _SharpenYOut[p] = yOut;
}

[numthreads(8,8,1)]
void BoxFilterH(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _BoxOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    int r = max(1, _BoxRadius);
    float sum = 0.0;
    for (int dx = -r; dx <= r; dx++)
    {
        int2 q = int2(clamp((int)id.x + dx, 0, (int)w - 1), (int)id.y);
        sum += _ScalarIn[q];
    }
    _BoxOut[p] = sum / (float)(2 * r + 1);
}

[numthreads(8,8,1)]
void BoxFilterV(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _BoxOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    int r = max(1, _BoxRadius);
    float sum = 0.0;
    for (int dy = -r; dy <= r; dy++)
    {
        int2 q = int2((int)id.x, clamp((int)id.y + dy, 0, (int)h - 1));
        sum += _ScalarIn[q];
    }
    _BoxOut[p] = sum / (float)(2 * r + 1);
}

[numthreads(8,8,1)]
void SquareScalar(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SquareOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);
    float v = _ScalarIn[p];
    _SquareOut[p] = v * v;
}

[numthreads(8,8,1)]
void GuidedAB(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _AOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);

    float meanI = _MeanIIn[p];
    float meanII = _MeanIIIn[p];
    float varI = max(0.0, meanII - meanI * meanI);
    float eps = max(1e-6, _GuidedEps);
    float a = varI / (varI + eps);
    float b = meanI * (1.0 - a);

    _AOut[p] = a;
    _BOut[p] = b;
}

[numthreads(8,8,1)]
void ApplyGuided(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _GuidedOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);
    float I = _ScalarIn[p];
    float a = _MeanAIn[p];
    float b = _MeanBIn[p];
    _GuidedOut[p] = saturate(a * I + b);
}

[numthreads(8,8,1)]
void MidFreq(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _MidOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);
    float I = _ScalarIn[p];
    float B = _BlurIn[p];
    float m = I - B;
    _MidOut[p] = m;
}

[numthreads(8,8,1)]
void HighFreq(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NoiseOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);
    float I = _ScalarIn[p];
    float B = _BlurIn[p];
    _NoiseOut[p] = I - B;
}

[numthreads(8,8,1)]
void BilateralNoise(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _NoiseOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float m = saturate(_FaceMaskIn[p]);
    if (m <= 0.001)
    {
        _NoiseOut[p] = 0.0;
        return;
    }

    int2 size = int2((int)w, (int)h);
    float center = _NoiseIn[p];
    float sigmaR = max(0.001, _BilateralSigmaRange);

    float sum = 0.0;
    float wsum = 0.0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
        {
            int2 q = clamp(p + int2(dx, dy), int2(0,0), size - 1);
            float v = _NoiseIn[q];
            float ds2 = (float)(dx * dx + dy * dy);
            float wr = exp(-((v - center) * (v - center)) / (2.0 * sigmaR * sigmaR));
            float ws = exp(-ds2 * 0.6);
            float ww = ws * wr;
            sum += v * ww;
            wsum += ww;
        }
    }

    float outV = sum / max(1e-6, wsum);
    _NoiseOut[p] = outV;
}

[numthreads(8,8,1)]
void FaceStruct(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _FaceStructOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 size = int2((int)w, (int)h);
    int2 p = int2(id.xy);

    float fm0 = saturate(_FaceMaskIn[p]);
    float fm = smoothstep(0.25, 0.50, fm0);
    if (fm <= 0.001)
    {
        _FaceStructOut[p] = _ScalarIn[p];
        return;
    }

    float I = _ScalarIn[p];
    float baseY = _GuidedIn[p];
    float mid = _MidIn[p] * fm;
    float noise = _NoiseFilteredIn[p];

    float y00 = Luma(SampleClamped(_Source, p + int2(-1, -1), size).rgb);
    float y10 = Luma(SampleClamped(_Source, p + int2( 0, -1), size).rgb);
    float y20 = Luma(SampleClamped(_Source, p + int2( 1, -1), size).rgb);
    float y01 = Luma(SampleClamped(_Source, p + int2(-1,  0), size).rgb);
    float y11 = Luma(SampleClamped(_Source, p, size).rgb);
    float y21 = Luma(SampleClamped(_Source, p + int2( 1,  0), size).rgb);
    float y02 = Luma(SampleClamped(_Source, p + int2(-1,  1), size).rgb);
    float y12 = Luma(SampleClamped(_Source, p + int2( 0,  1), size).rgb);
    float y22 = Luma(SampleClamped(_Source, p + int2( 1,  1), size).rgb);

    float gx = (-3.0*y00 + 3.0*y20) + (-10.0*y01 + 10.0*y21) + (-3.0*y02 + 3.0*y22);
    float gy = (-3.0*y00 - 10.0*y10 - 3.0*y20) + (3.0*y02 + 10.0*y12 + 3.0*y22);
    float Jxx = gx * gx;
    float Jyy = gy * gy;
    float Jxy = gx * gy;
    float trace = Jxx + Jyy;
    float det = Jxx * Jyy - Jxy * Jxy;
    float disc = max(0.0, trace * trace - 4.0 * det);
    float coh = sqrt(disc) / max(1e-6, trace);
    coh = saturate(coh);

    float edge = saturate(_AnalysisIn[p].x);
    float varTex = saturate(_AnalysisIn[p].w);
    float noiseEst = (1.0 - coh) * saturate(varTex * 1.2);

    baseY = lerp(baseY, I, smoothstep(0.06, 0.20, edge));

    float wMid = _MidW;
    float wwBase = (0.6 + 0.8 * edge - 0.4 * noiseEst);
    float ww = wwBase * wMid;
    ww *= (1.0 - 0.60 * noiseEst);
    ww = clamp(ww, 0.0, 6.0);
    float midBoost = 2.2;

    float midLim = lerp(0.030, 0.085, smoothstep(0.08, 0.35, edge));
    midLim *= (0.70 + 0.30 * (1.0 - noiseEst));
    mid = clamp(mid, -midLim, midLim);

    float texScale = _TextureScale * (1.0 - 0.70 * fm);
    float nf = noise / (1.0 + abs(noise) * 12.0);
    float cohGate = saturate((coh - 0.12) / 0.88);
    float texW = texScale * (0.25 + 0.75 * cohGate) * (1.0 - 0.70 * noiseEst) * (0.60 + 0.40 * edge);
    float tex = nf * texW;

    float outY = baseY + mid * (ww * midBoost) + tex;
    outY = clamp(outY, 0.0, 1.0);
    _FaceStructOut[p] = outY;
}

[numthreads(8,8,1)]
void FaceBlend(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _FaceEnhancedOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    int2 p = int2(id.xy);
    float fm0 = saturate(_FaceMaskIn[p]);
    float fm = smoothstep(0.25, 0.50, fm0);
    float I = _ScalarIn[p];
    float F = _FaceStructIn[p];
    _FaceEnhancedOut[p] = lerp(I, F, fm);
}

[numthreads(8,8,1)]
void DirectionalSharpen(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _SharpenYOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 size = int2((int)w, (int)h);
    int2 p = int2(id.xy);

    float3 c0 = SampleClamped(_Source, p, size).rgb;
    float y0 = Luma(c0);

    float4 an = _AnalysisIn[p];
    float edge = an.x;
    float2 dir = Normalize2(an.yz);
    float tex = an.w;
    float flat = _MaskIn[p];

    float2 t = Normalize2(float2(-dir.y, dir.x));
    int2 step = int2((int)round(t.x), (int)round(t.y));
    if (step.x == 0 && step.y == 0) step = int2(1, 0);

    float yP = Luma(SampleClamped(_Source, p + step, size).rgb);
    float yM = Luma(SampleClamped(_Source, p - step, size).rgb);
    float avgT = 0.5 * (yP + yM);
    float dirDetail = y0 - avgT;

    float baseY = Luma(_BaseIn[p].rgb);
    float enh = _EnhancedDetailIn[p];

    float wTex = saturate(tex * 3.0);
    float wEdge = saturate(edge);

    float detailGain = lerp(0.85, 2.20, wTex) * (1.0 - 0.20 * wEdge);
    float dirGain = _DirStrength * (0.20 + 0.80 * wTex) * (1.0 - 0.20 * wEdge);

    float y = baseY + enh * detailGain + dirDetail * dirGain * 10;
    y = saturate(y);

    _SharpenYOut[p] = y;
}


[numthreads(8,8,1)]
void SkinNoiseProtect(uint3 id : SV_DispatchThreadID)
{
    uint w, h;
    _Result.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    int2 p = int2(id.xy);
    float3 rgb = _Source[p].rgb;
    float3 ycc = YCbCrFromRgb(rgb);

    float newY = _SharpenYIn[p];

    float cb255 = ycc.y * 255.0;
    float cr255 = ycc.z * 255.0;
    float skin = step(77.0, cb255) * step(cb255, 127.0) * step(133.0, cr255) * step(cr255, 173.0);

    float tex = _AnalysisIn[p].w;
    float gate = saturate((tex - 0.006) * 30.0);

    float protect = lerp(1.0, 0.55, skin);
    protect = protect * lerp(0.92, 1.0, gate);

    float yOut = lerp(ycc.x, newY, protect);
    float3 outRgb = RgbFromYCbCr(float3(yOut, ycc.y, ycc.z));
    outRgb = Clamp01(outRgb);

    _Result[p] = float4(outRgb, 1);
}

