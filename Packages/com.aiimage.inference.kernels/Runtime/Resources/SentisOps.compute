#pragma kernel SentisNonZeroLinear
#pragma kernel SentisCompressLinear
#pragma kernel SentisGatherNDLinear
#pragma kernel SentisScatterLinear
#pragma kernel SentisTopKLinear
#pragma kernel SentisOneHotLinear

// D3 shape/index kernels intentionally use textures only. _ShapeOut[0] stores
// logical length, _ShapeOut[1] stores overflow (0/1); neither value is read back
// by the execution plan.
Texture2D<float> _Values;
Texture2D<int> _Indices;
Texture2D<int> _Parameter;
Texture2D<float> _Updates;
RWTexture2D<float> _Output;
RWTexture2D<int> _IndexOutput;
RWTexture2D<int> _ShapeOut;
int _InputLength;
int _Capacity;
int _KOrDepth;
int _Largest;
float _OffValue;
float _OnValue;

int ReadInt(Texture2D<int> texture, int index) { return texture[int2(index, 0)]; }
float ReadValue(Texture2D<float> texture, int index) { return texture[int2(index, 0)]; }

[numthreads(1, 1, 1)]
void SentisNonZeroLinear(uint3 id : SV_DispatchThreadID)
{
    int count = 0;
    [loop] for (int i = 0; i < _InputLength; ++i)
        if (ReadValue(_Values, i) != 0.0) { if (count < _Capacity) _IndexOutput[int2(count, 0)] = i; ++count; }
    _ShapeOut[int2(0, 0)] = min(count, _Capacity);
    _ShapeOut[int2(1, 0)] = count > _Capacity ? 1 : 0;
}

[numthreads(1, 1, 1)]
void SentisCompressLinear(uint3 id : SV_DispatchThreadID)
{
    int count = 0;
    [loop] for (int i = 0; i < _InputLength; ++i)
        if (ReadInt(_Indices, i) != 0) { if (count < _Capacity) _Output[int2(count, 0)] = ReadValue(_Values, i); ++count; }
    _ShapeOut[int2(0, 0)] = min(count, _Capacity);
    _ShapeOut[int2(1, 0)] = count > _Capacity ? 1 : 0;
}

[numthreads(64, 1, 1)]
void SentisGatherNDLinear(uint3 id : SV_DispatchThreadID)
{
    int i = id.x;
    if (i >= _Capacity) return;
    int source = ReadInt(_Indices, i);
    _Output[int2(i, 0)] = source >= 0 && source < _InputLength ? ReadValue(_Values, source) : 0.0;
}

[numthreads(1, 1, 1)]
void SentisScatterLinear(uint3 id : SV_DispatchThreadID)
{
    [loop] for (int i = 0; i < _InputLength; ++i) _Output[int2(i, 0)] = ReadValue(_Values, i);
    // Planner accepts only statically/provably unique destinations. Serial writes
    // make that public reject-on-conflict contract deterministic on every backend.
    [loop] for (int i = 0; i < _Capacity; ++i) { int dst = ReadInt(_Indices, i); if (dst >= 0 && dst < _InputLength) _Output[int2(dst, 0)] = ReadValue(_Updates, i); }
}

[numthreads(1, 1, 1)]
void SentisTopKLinear(uint3 id : SV_DispatchThreadID)
{
    int requestedK = ReadInt(_Parameter, 0);
    int k = min(max(0, requestedK), min(_InputLength, _Capacity));
    [loop] for (int rank = 0; rank < k; ++rank) {
        int chosen = -1; float chosenValue = 0.0;
        [loop] for (int candidate = 0; candidate < _InputLength; ++candidate) {
            float value = ReadValue(_Values, candidate); int ahead = 0;
            [loop] for (int other = 0; other < _InputLength; ++other) { float otherValue = ReadValue(_Values, other); bool better = _Largest != 0 ? (otherValue > value || (otherValue == value && other < candidate)) : (otherValue < value || (otherValue == value && other < candidate)); if (better) ++ahead; }
            if (ahead == rank) { chosen = candidate; chosenValue = value; break; }
        }
        _Output[int2(rank, 0)] = chosenValue; _IndexOutput[int2(rank, 0)] = chosen;
    }
    _ShapeOut[int2(0, 0)] = k; _ShapeOut[int2(1, 0)] = requestedK > _Capacity ? 1 : 0;
}

[numthreads(64, 1, 1)]
void SentisOneHotLinear(uint3 id : SV_DispatchThreadID)
{
    int linear = id.x; int requestedDepth = ReadInt(_Parameter, 0); int depth = min(max(0, requestedDepth), _Capacity); int total = _InputLength * depth;
    if (linear >= total) return;
    int row = linear / depth; int column = linear - row * depth; int index = ReadInt(_Indices, row); if (index < 0) index += depth;
    _Output[int2(linear, 0)] = index == column ? _OnValue : _OffValue;
    if (linear == 0) { _ShapeOut[int2(0, 0)] = depth; _ShapeOut[int2(1, 0)] = requestedDepth > _Capacity ? 1 : 0; }
}
